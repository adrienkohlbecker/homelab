#cloud-config
# Render /etc/hosts (including `127.0.1.1 test2`, the meta-data local-hostname)
# so sudo/PAM's name lookup during the first `become` resolves locally instead
# of hitting DNS. Minimal is absent from data/network_topology.yml, so its only
# resolver is qemu's user-net DNS forwarder -- a NAT-DNS path that can exceed
# Mitogen's 10-second become-bootstrap deadline. Lab and Pug avoid this through
# Packer's etc_hosts seeding plus topology addressing; the cloud image has
# neither, so seed it here.
manage_etc_hosts: true
ssh_authorized_keys:
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key
# The Packer fixtures ship the journal-mirror unit in their image; the stock
# cloud image has none, so the harness adds test/homelab_guest_journal.service
# to write_files when it builds the seed.
# runcmd is the last thing cloud-init runs, so a hang before it leaves the
# mirror unstarted; the serial console artifact (boot.ansi) still holds that
# case, and --lines=all replays the whole journal once the unit does start.
runcmd:
  - - systemctl
    - enable
    - --now
    - homelab_guest_journal.service
  - - systemctl
    - mask
    - --now
    - serial-getty@hvc0.service
