{
  "permissions": {
    "ask": [
      "Bash(mise run ansible:*)",
      "Bash(mise run ansible:bunk:*)",
      "Bash(ansible-playbook:*)",
      "Bash(uv run ansible-playbook:*)",
      "Bash(mise run tf apply:*)",
      "Bash(mise run tf destroy:*)",
      "Bash(mise run ha:sync push:*)",
      "Bash(mise run ha:sync sync:*)"
    ],
    "deny": [
      "Bash(./vault-client.sh:*)",
      "Bash(ansible-vault view:*)",
      "Bash(ansible-vault decrypt:*)",
      "Bash(ansible-vault edit:*)",
      "Bash(uv run ansible-vault view:*)",
      "Bash(uv run ansible-vault decrypt:*)",
      "Bash(security find-generic-password:*)",
      "Bash(mise run wg:show:*)",
      "Bash(op read:*)",
      "Bash(op item:*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/worktree_create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/worktree_remove.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/validate_on_edit.sh"
          }
        ]
      }
    ]
  }
}
