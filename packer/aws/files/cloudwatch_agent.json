{
  "agent": {
    "metrics_collection_interval": 5,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "homelab-ci",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      [
        "AutoScalingGroupName"
      ]
    ],
    "metrics_collected": {
      "cpu": {
        "totalcpu": true,
        "measurement": [
          "cpu_usage_active",
          "cpu_usage_iowait",
          "cpu_usage_steal"
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available"
        ]
      },
      "swap": {
        "measurement": [
          "swap_used_percent",
          "swap_used"
        ]
      },
      "diskio": {
        "resources": [
          "nvme*n1",
          "md*"
        ],
        "measurement": [
          "reads",
          "writes",
          "read_bytes",
          "write_bytes",
          "read_time",
          "write_time",
          "io_time",
          "iops_in_progress"
        ]
      },
      "processes": {
        "measurement": [
          "running",
          "blocked"
        ]
      },
      "disk": {
        "resources": [
          "/",
          "/mnt/scratch"
        ],
        "measurement": [
          "used_percent"
        ]
      },
      "net": {
        "resources": [
          "ens*",
          "eth*"
        ],
        "measurement": [
          "bytes_recv",
          "bytes_sent"
        ]
      },
      "procstat": [
        {
          "pattern": "qemu-system",
          "measurement": [
            "pid_count",
            "memory_rss",
            "cpu_usage"
          ]
        }
      ]
    }
  }
}
