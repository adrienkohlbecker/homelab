{# Bind behind nginx and disable the editor so devices.json stays managed. #}
{# bcastip only defaults the disabled editor, so keep it inert rather than  #}
{# coupling it to the host's computed broadcast.                           #}
{
  "host": "127.0.0.1",
  "port": {{ service_ports.wolweb }},
  "vdir": "/",
  "bcastip": "255.255.255.255:9",
  "read_only": true
}
