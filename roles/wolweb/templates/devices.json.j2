#jinja2: trim_blocks: True, lstrip_blocks: True
{# `ip` is the packet destination, not the device address: the host's       #}
{# broadcast by default, or the UDM gateway for cross-VLAN relay.           #}
{# `interface` selects the host NIC; config.json bcastip is not used here.  #}
{
  "devices": [
{% for d in wolweb_devices %}
    {
      "name": "{{ d.name }}",
      "mac": "{{ d.mac }}",
      "ip": "{{ d.wake_destination | default(wolweb_broadcast_ip ~ ':9') }}",
      "interface": "{{ ansible_facts.default_ipv4.interface }}"
    }{{ "," if not loop.last else "" }}
{% endfor %}
  ]
}
