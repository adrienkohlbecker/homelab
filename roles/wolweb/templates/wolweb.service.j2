#jinja2: lstrip_blocks: True
# wolweb.service #######################################################################
[Unit]
Description=wolweb
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
{% endif %}
# No zfs_autosnapshot PartOf: both mounted files are read-only.

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
TimeoutSec=120
RestartSec=5
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

ExecStartPre=/bin/rm -f %t/%n.ctr-id
{# Host networking lets wolweb bind the NIC named in devices.json and send #}
{# L2 broadcasts; udm_wol_relay handles cross-VLAN wakes.                  #}
{# --cap-drop=ALL is safe: sending a UDP datagram needs no capability.     #}
{# The image's WOLWEB* environment overrides config.json, so clear the      #}
{# known values and keep the mounted configuration authoritative.          #}
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --init \
    --name wolweb \
    --log-driver journald \
    --log-opt tag="wolweb" \
    --volume /mnt/services/wolweb/config.json:/wolweb/config.json:ro \
    --volume /mnt/services/wolweb/devices.json:/wolweb/devices.json:ro \
    --user {{ wolweb_user.uid }}:{{ wolweb_user.gid }}  \
    --security-opt=no-new-privileges \
    --cap-drop=ALL \
    --unsetenv WOLWEBPORT \
    --unsetenv WOLWEBVDIR \
    --unsetenv WOLWEBHOST \
    --unsetenv WOLWEBBCASTIP \
    --unsetenv WOLWEBREADONLY \
    --network host \
    --health-cmd {{ ('http://localhost:' ~ service_ports.wolweb ~ '/health') | podman_health_curl(location=false) }} \
    --health-startup-cmd {{ ('http://localhost:' ~ service_ports.wolweb ~ '/health') | podman_health_curl(location=false) }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "100s" \
    --stop-timeout 120 \
    {{ wolweb_image }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
