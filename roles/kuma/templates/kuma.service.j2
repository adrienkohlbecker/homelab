#jinja2: lstrip_blocks: True
# kuma.service #######################################################################
[Unit]
Description=kuma
After=network-online.target
Wants=network-online.target
StartLimitInterval=600
StartLimitBurst=3
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
# First boot can take 30-60s. The stop budget gives podman 120s for a graceful
# SQLite WAL flush, plus 30s before systemd resorts to SIGKILL.
TimeoutStartSec=120
TimeoutStopSec=150
RestartSec=5
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name kuma \
    --network kuma \
    --user {{ kuma_user.uid }}:{{ kuma_user.gid }} \
    {# The image already runs the server under dumb-init. #}
    --log-driver journald \
    --log-opt tag="kuma" \
    --security-opt=no-new-privileges \
    {# Without an existing DB, v2 waits for a database choice while its healthcheck
       still passes. Pin SQLite so fresh and restored hosts expose real routes. #}
    --env UPTIME_KUMA_DB_TYPE=sqlite \
    {# Fluent Bit maps Kuma's JSON fields into the common lnav shape. #}
    --env UPTIME_KUMA_LOG_FORMAT=json \
    {# The auth seed and volume share this explicit database root. #}
    --env DATA_DIR=/app/data \
    --volume /mnt/services/kuma:/app/data \
    --publish 127.0.0.1:{{ service_ports.kuma }}:3001/tcp \
    {# The pinned database type makes Kuma's native healthcheck meaningful. #}
    --health-cmd {{ ["extra/healthcheck"] | json_argv }} \
    --health-startup-cmd {{ ["extra/healthcheck"] | json_argv }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "100s" \
    --stop-timeout 120 \
    {{ kuma_image }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
{% if zfs_root %}
WantedBy=zfs_autosnapshot.target
{% endif %}
