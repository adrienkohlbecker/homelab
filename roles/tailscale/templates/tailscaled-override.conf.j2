#jinja2: lstrip_blocks: True
[Unit]
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
# Keep final NetInfo results and failures; discard intermediate probes and
# routine path churn before they reach the journal.
LogFilterPatterns=~^netcheck: (netcheck: )?UDP is blocked, trying (HTTPS|ICMP)$
LogFilterPatterns=~^netmap: suggested exit node:  [(][)]$
LogFilterPatterns=~^netcheck: DetectCaptivePortal[(]found=false[)]$
LogFilterPatterns=~^magicsock: disco: node [[][^]]+[]] d:[^ ]+ now using [^ ]+ mtu=[0-9]+ tx=[^ ]+$
LogFilterPatterns=~^magicsock: disco: failed to send ping .* sendto: destination address required$
LogFilterPatterns=~^magicsock: derp-[0-9]+ does not know about peer [[][^]]+[]], removing route$

{% if ansible_default_ipv4.interface is defined %}
# Apply UDP GRO forwarding offload on the underlay NIC whenever tailscaled
# starts. This keeps the runtime setting aligned across restarts and reboots.
# https://tailscale.com/kb/1320/performance-best-practices
# -prefix: drivers that reject the offload (e.g. qemu virtio) are ignored.
ExecStartPost=-/usr/sbin/ethtool -K {{ ansible_default_ipv4.interface }} rx-udp-gro-forwarding on rx-gro-list off
{% endif %}
