#!/bin/bash
# Points wg0 peers with a DNS-named endpoint at the address the name has now.
# wg0.conf omits these endpoints so that bring-up never waits on DNS.
set -euo pipefail

# The timer can fire during boot or a wg-quick restart.
[[ -e /sys/class/net/wg0 ]] || exit 0

now=$(date +%s)
handshakes=$(wg show wg0 latest-handshakes)

while read -r public_key endpoint wg_address; do
  latest=$(awk -v key="$public_key" '$1 == key { print $2 }' <<<"$handshakes")
  [[ -n $latest ]] || continue

  # A live session keeps the address WireGuard roamed to: a peer behind NAT
  # reaches us from a port its DNS name knows nothing about. 135 s is upstream
  # reresolve-dns.sh's limit, just past one rekey interval.
  if ((now - latest < 135)); then
    continue
  fi

  # Fail fast on a DNS outage and try again on the next run. If it lasts, the
  # netdata handshake alarm reports the dead link.
  WG_ENDPOINT_RESOLUTION_RETRIES=0 wg set wg0 peer "$public_key" endpoint "$endpoint" || continue

  # Setting an endpoint sends nothing, and handshake retries may have given up,
  # so send a packet to start one. A peer that stays down is expected here.
  ping -c 1 -W 1 "$wg_address" >/dev/null 2>&1 || true
done </etc/wireguard/wg0_dynamic_peers
