
# Loads default set of integrations. Do not remove.
default_config:

# Core location and locale. These default to HA's GUI-owned .storage/core.config,
# but this block still overrides it outright -- so they are declared here rather
# than living only in the UI, where a from-nothing rebuild would lose them.
#
# All-or-nothing on purpose. Setting any key here flips config_source to `yaml`,
# and the frontend gates Settings -> System -> General and the URL page on
# config_source being storage/default -- so the page goes read-only whether or
# not a given key is listed. Naming only some of them would lock the page over
# values still owned solely by .storage, which is worse than either extreme.
# That is also why `name` and `radius` appear despite matching HA's defaults.
#
# Consequence to know before editing in the UI: those fields are now read-only
# there. Changing the house location means editing the vault and re-converging.
homeassistant:
  name: Home
  # Vaulted -- the coordinates identify the house and this repo is public.
  latitude: {{ homeassistant_latitude }}
  longitude: {{ homeassistant_longitude }}
  elevation: {{ homeassistant_elevation }}
  # Radius of the `zone.home` geofence, in metres.
  radius: 100
  unit_system: metric
  time_zone: {{ system_timezone }}
  currency: EUR
  country: FR
  language: en
  # Same vhost the nginx_site call below the role builds. HA hands this to the
  # companion apps and to any integration that renders an absolute link.
  external_url: https://homeassistant.{{ inventory_hostname }}.{{ domain }}/


# Load frontend themes from the themes folder
frontend:
  themes: !include_dir_merge_named themes

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml
sensor: !include sensors.yaml
template: !include templates.yaml
input_number: !include input_numbers.yaml
input_select: !include input_selects.yaml
timer: !include timers.yaml
# Daily Daikin write tally + safety cap for the HVAC Room Control loops
# (reset at 00:00 by the HVAC Write Counter Reset automation).
counter: !include counters.yaml
# climate_template platform from HACS (litinoveweedle/hass-template-climate):
# per-room dashboard thermostats wrapping the Daikin units.
climate: !include climate.yaml

# Default "Overview" dashboard stays storage-mode (UI-editable). Repo-owned
# dashboards are YAML-mode: authored in the ha_gui_config clone under dashboards/
# and deployed by `mise run ha:sync push` (read-only in the UI, re-read on load).
# Each needs an explicit entry here — HA can't glob a dashboards/ dir.
# The url_path keys MUST contain a hyphen (HA rejects single-word custom paths).
lovelace:
  mode: storage
  dashboards:
    climate-control:
      mode: yaml
      title: Climate
      icon: mdi:home-thermometer
      show_in_sidebar: true
      filename: dashboards/climate.yaml
    sun-calibration:
      mode: yaml
      title: Sun Calibration
      icon: mdi:weather-sunset
      show_in_sidebar: true
      filename: dashboards/sun_calibration.yaml

# notify.family fans one message out to both phones. Consumed by household
# alerts in automations.yaml (water leak, humidifier-empty, dog-walk reminder)
# so those don't duplicate per-phone notify calls. The mobile_app_* notify
# services it references are created by default_config; this just bundles them.
notify:
  - platform: group
    name: family
    services:
      - service: mobile_app_adriens_iphone
      - service: mobile_app_iphone_de_{{ spouse_firstname }}

recorder:
  db_url: sqlite:////config/db/home-assistant_v2.db
