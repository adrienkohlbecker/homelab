#jinja2: lstrip_blocks: True
# headscale.service ##################################################################
[Unit]
Description=headscale
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
{% if not qemu_test %}
# Fox reaches its Authelia issuer over wg0; the fixture has no such unit.
After=wg-quick@wg0.service
{% endif %}
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
TimeoutStartSec=120
TimeoutStopSec=70
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name headscale \
    --network headscale \
    --user {{ headscale_user.uid }}:{{ headscale_user.gid }} \
    --log-driver journald \
    --log-opt tag="headscale" \
    --security-opt=no-new-privileges \
    {# Headscale runs directly as PID 1; tini reaps and forwards signals. #}
    --init \
    --volume /mnt/services/headscale/config.yaml:/etc/headscale/config.yaml:ro \
    --volume /mnt/services/headscale/acl.hujson:/etc/headscale/acl.hujson:ro \
    --volume /mnt/services/headscale/data:/var/lib/headscale \
    --publish 127.0.0.1:{{ service_ports.headscale }}:8080/tcp \
    {# Unauthenticated metrics stay on loopback for Netdata. #}
    --publish 127.0.0.1:{{ service_ports.headscale_metrics }}:9090/tcp \
    {# Netavark maps both host families to the dual-stack STUN socket. #}
    --publish 0.0.0.0:{{ service_ports.headscale_stun }}:3478/udp \
    --publish '[::]:{{ service_ports.headscale_stun }}:3478/udp' \
    --secret=headscale_oidc_secret,type=mount,target=oidc_client_secret \
    {# The native CLI round-trips through gRPC; the image has no HTTP client. #}
    --health-cmd         {{ ["headscale", "users", "list"] | json_argv }} \
    --health-startup-cmd {{ ["headscale", "users", "list"] | json_argv }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "60s" \
    --stop-timeout 30 \
    {{ headscale_image }} \
    serve
# A replacement may receive a new DNAT target while UDP conntrack still points
# at the old address. Once healthy, discard only STUN flows; missing flows are
# benign.
ExecStartPost=-/usr/sbin/conntrack --delete --family ipv4 --proto udp --dport {{ service_ports.headscale_stun }}
ExecStartPost=-/usr/sbin/conntrack --delete --family ipv6 --proto udp --dport {{ service_ports.headscale_stun }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
{% if zfs_root %}
WantedBy=zfs_autosnapshot.target
{% endif %}
