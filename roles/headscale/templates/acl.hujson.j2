// Managed by Ansible (roles/headscale). HuJSON (JSON + comments/trailing commas).
//
// This single-household tailnet intentionally lets every member reach every
// other member. Subnet and exit-node routes are approved explicitly by the
// tailscale role, so this policy needs no groups, tagOwners, or autoApprovers.
{
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"],
    },
  ],
}
