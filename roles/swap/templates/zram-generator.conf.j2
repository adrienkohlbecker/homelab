# This config file enables a /dev/zram0 swap device
#
# This device's properties can be modified by adding options under the
# `[zram0]` section, or disabled by removing the section header.
# Additional zram devices can be created by appending new `[zramX]`
# sections and setting the appropriate options for each device.
#
# See /usr/share/doc/systemd-zram-generator/zram-generator.conf.example
# and/or zram-generator.conf(5) for a list of available options.
#
# zram swap: the primary, high-priority swap device. Routine cold-page
# eviction compresses into RAM here; partition swap (priority 10) is
# reached only under genuine exhaustion. See
# notes/swap_strategy.md.
[zram0]
# Size = min(ram, max-zram-size). Noble's 1.0.0 sizes via zram-fraction +
# max-zram-size (the zram-size expression is 1.x-only); both keys work on
# 1.x too. fraction 1.0 means "up to all of RAM", capped at the MB below
# -- so a small box gets ~RAM, a big box the cap. The cap also stops a
# worst-case incompressible fill (stored ~1:1) from consuming more RAM
# than the box has.
zram-fraction = 1.0
max-zram-size = {{ (swap_zram.size | human_to_bytes) // 1048576 }}
compression-algorithm = {{ swap_zram.algorithm | default('zstd') }}
swap-priority = 100
