# {{ ansible_managed }} -- source: roles/ntp/templates/chrony.conf.j2
# NTS prevents unauthenticated sources from steering the clock. Ubuntu's pools
# and DHCP sourcedir are intentionally absent because neither requires NTS.

server time.cloudflare.com iburst nts
server ptbtime1.ptb.de iburst nts
server nts.netnod.se iburst nts

# Defense in depth: automatically mark any unauthenticated source noselect.
authselectmode require

# Require agreement from two independent sources.
minsources 2

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync

# Keep command access on the root-only Unix socket.
cmdport 0

# Step large offsets during initial synchronisation.
makestep 1 3

# TAI-UTC offset + leap seconds from the system tz database.
leapsectz right/UTC
