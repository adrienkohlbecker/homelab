global_defs {
  # Run scripts as nobody unless a vrrp_script explicitly opts up.
  enable_script_security
  script_user nobody
}

vrrp_script adguard_healthcheck {
  script    /usr/local/bin/adguard_healthcheck
  interval  1
  timeout   5
  rise      1
  fall      2
  user      root
  # Enter FAULT until AdGuard passes its first healthcheck after a restart.
  init_fail
}

# The instance name describes the DNS VIP; its script probes AdGuard.
vrrp_instance dns {
  state     BACKUP
  interface {{ default_interface }}

  # Keep UniFi's host and DNS VIP clients distinct by using the VRRP vmac.
  use_vmac
  # Keep peer adverts and DNS replies on the firewall-managed parent interface.
  vmac_xmit_base

  check_unicast_src

  unicast_src_ip {{ external_ips[inventory_hostname] }}
  unicast_peer {
    {% for name in dns_keepalived_peers | select("ne", inventory_hostname) | sort %}
    {{ external_ips[name] }}
    {% endfor %}
  }

  virtual_router_id {{ dns_keepalived_vrid }}
  priority          {{ dns_keepalived_priority }}
  advert_int        1

  # Let a recovered preferred resolver stay healthy before reclaiming the VIP.
  preempt_delay     60

  # Keepalived already tracks the parent through the vmac; track_interface
  # would be redundant and makes validation fail with a warning.

  virtual_ipaddress {
    {{ network.virtual_ips.dns }}/32
  }

  # Refresh stale LAN caches after a MASTER transition.
  garp_master_repeat 3
  garp_master_refresh 60

  track_script {
    adguard_healthcheck
  }
}
