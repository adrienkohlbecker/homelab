# The VRRP vmac receives legitimate asymmetric LAN traffic that the kernel
# otherwise logs as martian noise. Apply at interface creation because the vmac
# does not exist when sysctl.d runs. Writing /proc avoids sysctl interpreting
# the dot in names such as vrrp.1. This per-interface zero depends on the
# firewall role keeping net.ipv4.conf.all.log_martians=0.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="vrrp*", RUN+="/bin/sh -c 'echo 0 > /proc/sys/net/ipv4/conf/%k/log_martians'"
