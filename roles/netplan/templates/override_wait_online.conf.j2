[Unit]
# Netplan gates wait-online on a symlink its generator creates only when a
# configured NIC already exists early in boot. A NIC whose driver loads after
# the generators (a Dracut initrd, a cloud image) otherwise leaves
# network-online.target satisfied before DHCP. The empty assignment resets
# every condition, including the stock CAP_NET_ADMIN check that only matters
# inside unprivileged containers.
ConditionPathIsSymbolicLink=
{% if ansible_distribution_release != 'noble' %}
# --dns queries resolved's DNS configuration.
After=systemd-resolved.service
{% endif %}

[Service]
# Replace Netplan's per-interface list, captured at generator time, with
# "any managed link is routable". --dns (systemd 258+, so not Noble's 255)
# additionally needs a DNS server with a route to it, as Netplan 1.2 requests.
# Without it a statically addressed link (lab's iot VLAN) satisfies the wait
# at carrier, before DHCP configures the uplink; Netplan 1.1.2's own
# "--any -o routable" wait shares that gap on Noble.
# --timeout pins the upstream default (systemd-networkd-wait-online.service(8)):
# the oneshot unit has no start timeout of its own, and _verify sizes its boot
# poll against this bound.
ExecStart=
ExecStart=/usr/lib/systemd/systemd-networkd-wait-online --any --operational-state=routable --timeout=120{{ ' --dns' if ansible_distribution_release != 'noble' else '' }}
