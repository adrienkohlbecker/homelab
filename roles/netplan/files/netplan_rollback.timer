[Unit]
Description=Netplan auto-rollback timer (armed by the role's safe-apply path)

[Timer]
# Leave 30s after the SSH canary fails before restoring.
OnActiveSec=90
# The one-minute default accuracy would widen the lockout window to 150s.
AccuracySec=1s
# Never persist or enable this runtime deadline: its /run snapshot disappears
# at reboot, leaving nothing safe to restore.
Unit=netplan_rollback.service
