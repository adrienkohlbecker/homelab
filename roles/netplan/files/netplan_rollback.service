[Unit]
Description=Netplan auto-rollback (fires 90s after a safe-apply if SSH never came back)
# A fired-but-cancelled timer becomes a visible condition skip; the apply path
# clears stale markers before arming.
ConditionPathExists=!/run/netplan_keep

[Service]
Type=oneshot
# Bound the oneshot because its default start timeout is infinite.
TimeoutStartSec=120
SyslogIdentifier=%N
ExecStart=/usr/local/bin/netplan_rollback
