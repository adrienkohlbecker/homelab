#jinja2: lstrip_blocks: True
# redis.service #######################################################################
[Unit]
Description=redis
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
TimeoutSec=60
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
Type=notify
# NotifyAccess=all (not main): with --sdnotify=healthy the readiness ping comes
# from conmon relaying the container healthcheck, not the unit's main PID.
NotifyAccess=all
SyslogIdentifier=%N

# --entrypoint bypasses the image entrypoint's redis-server branch, which would
# otherwise --loadmodule every bundled Redis 8 module. redis-server runs as PID
# 1, handles SIGTERM and reaps its own RDB fork, so it needs no --init.
ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name redis \
    --security-opt=no-new-privileges \
    --log-driver journald \
    --log-opt tag="redis" \
    --volume /mnt/services/redis/config:/usr/local/etc/redis:ro \
    --volume /mnt/services/redis/data:/data \
    --user {{ redis_user.uid }}:{{ redis_user.gid }} \
    --network authelia \
    --health-cmd {{ ["redis-cli", "-e", "ping"] | json_argv }} \
    --health-startup-cmd {{ ["redis-cli", "-e", "ping"] | json_argv }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "30s" \
    --stop-timeout 30 \
    --entrypoint redis-server \
    {{ redis_image }} \
    /usr/local/etc/redis/redis.conf
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
{% if zfs_root %}
WantedBy=zfs_autosnapshot.target
{% endif %}
