# Snapshot to /data/dump.rdb after 60s if >=1 key changed. RDB-only (no AOF):
# a clean SIGTERM -- the nightly zfs_autosnapshot stop/start, and any
# `systemctl restart` -- writes a final snapshot, so Authelia sessions survive.
# An unclean crash loses up to 60s of logins, which only means signing in again.
dir /data
save 60 1
# A failed snapshot (say a full dataset) must only cost persistence, not
# refuse every write and with it every Authelia login.
stop-writes-on-bgsave-error no

# Authelia's sessions are a few hundred bytes each, so this bound is generous.
# volatile-lru (every Authelia session carries a TTL) evicts the least recently
# used sessions if it is ever reached, instead of refusing new logins.
maxmemory 64mb
maxmemory-policy volatile-lru

# maxmemory bounds the dataset but NOT per-client connection buffers, which are
# accounted separately. Cap them too so a stuck client cannot grow its output
# buffer without bound.
maxmemory-clients 10%

# Unauthenticated clients only get PING, which the healthcheck uses. Authelia
# gets every command except admin (CONFIG, REPLICAOF, DEBUG, MODULE, ...) and
# scripting, which it never issues. Only the password's SHA-256 lands on disk.
user default on nopass -@all +ping
user authelia on #{{ redis_authelia_password | hash('sha256') }} ~* +@all -@admin -@scripting
