# See avahi-daemon.conf(5) for more information on this configuration
# file!

[server]
#host-name=foo
# Pin the advertised hostname to inventory rather than mutable system state.
host-name={{ ansible_hostname }}
#domain-name=local
#browse-domains=0pointer.de, zeroconf.org
use-ipv4=yes
# Publish only IPv4 addresses; AAAA publication over IPv4 is disabled below.
use-ipv6=no
#allow-interfaces=eth0
# Avoid collision renames when macvlan siblings share the uplink's L2.
allow-interfaces={{ default_interface }}
#deny-interfaces=eth1
#check-response-ttl=no
# Reject responses that are not direct-link multicast.
check-response-ttl=yes
#use-iff-running=no
#enable-dbus=yes
#disallow-other-stacks=no
# systemd-resolved has MulticastDNS=no; fail if another responder claims UDP 5353.
disallow-other-stacks=yes
#allow-point-to-point=no
#cache-entries-max=4096
#clients-max=4096
#objects-per-client-max=1024
#entries-per-entry-group-max=32
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
enable-wide-area=yes

[publish]
#disable-publishing=no
#disable-user-service-publishing=no
#add-service-cookie=no
#publish-addresses=yes
publish-hinfo=no
publish-workstation=no
#publish-domain=yes
#publish-dns-servers=192.168.50.1, 192.168.50.2
#publish-resolv-conf-dns-servers=yes
publish-aaaa-on-ipv4=no
publish-a-on-ipv6=no

[reflector]
#enable-reflector=no
#reflect-ipv=no
#reflect-filters=_airplay._tcp.local,_raop._tcp.local

[rlimits]
#rlimit-as=
#rlimit-core=0
#rlimit-data=8388608
#rlimit-fsize=0
#rlimit-nofile=768
#rlimit-stack=8388608
#rlimit-nproc=3
