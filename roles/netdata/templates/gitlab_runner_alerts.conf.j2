# GitLab Runner exposes failed jobs as a counter split by failure_reason. The
# Prometheus collector maps counter increments to a failures/s chart, so any
# positive sample in the lookup window represents a new failed job.
#
# Script failures, configuration mistakes, and cancellations are normal CI
# outcomes already visible on the pipeline. Everything else points to runner
# infrastructure, an image pull problem, an execution timeout, an unknown
# failure, or a future failure class worth surfacing to the operator.

template: gitlab_runner_actionable_failure
      on: prometheus.gitlab_runner.gitlab_runner_failed_jobs_total
   class: Errors
    type: System
component: GitLab Runner
chart labels: failure_reason=!script_failure !configuration_error !job_canceled *
  lookup: max -{{ '30s' if (qemu_test | default(false)) else '5m' }} unaligned of gitlab_runner_failed_jobs_total
   units: failures/s
   every: 10s
    warn: $this > 0
 summary: GitLab runner ${label:runner_name} reported ${label:failure_reason}
    info: A CI job failed for a reason that may require operator action. Inspect the failed job and runner logs; ordinary script, configuration, and cancellation outcomes are excluded.
      to: sysadmin
