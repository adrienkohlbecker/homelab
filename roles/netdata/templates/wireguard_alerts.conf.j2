# Disabled while bunk is unavailable. The 900s/1200s thresholds assume lab and
# pug send their configured 25s keepalive. Scope the alarm to bunk because idle
# mobile peers legitimately have old handshakes. Netdata normalizes `=` to `:`
# in chart-label values, so normalize the public key the same way below.

# template: wireguard_bunk_peer_handshake_stale
#       on: wireguard.peer_latest_handshake_ago
# chart labels: public_key=<{{ '{{' }} wireguard_keys.bunk.public_key | replace('=', ':') {{ '}}' }}>
#    class: Errors
#     type: System
# component: Network
#     calc: $time
#    units: seconds
#    every: 30s
#     warn: $this > 900
#     crit: $this > 1200
#    delay: down 30m multiplier 1.5 max 1h
#  summary: WireGuard bunk peer (${label:device}) handshake stale
#     info: lab/pug sends a 25s keepalive to bunk; handshake_ago > 900s means the offsite backup link is unreachable. Catches the failure before the next nightly zfs send (which would also fail via systemd_service_unit_failed_state).
#       to: sysadmin
