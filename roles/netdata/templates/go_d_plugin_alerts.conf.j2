# Netdata ships this template silent. A configured collector that keeps
# failing is actionable, but the nightly zfs_autosnapshot quiesce makes the
# kuma and minio Prometheus jobs miss about two minutes of scrapes. Require a
# full 5m failure window before warning; once warned, keep the alert latched
# until the window contains only successful samples.

   template: plugin_data_collection_status
         on: netdata.plugin_data_collection_status
      class: Errors
       type: Netdata
  component: go.d.plugin
     lookup: average -5m unaligned of failed
      units: status
      every: 10s
       warn: $this == 1 || ($status >= $WARNING && $this > 0)
    summary: Data collection failure (${label:_collect_plugin}:${label:_collect_module}:${label:_collect_job})
       info: Data collection failure (${label:_collect_plugin}:${label:_collect_module}:${label:_collect_job})
         to: sysadmin
