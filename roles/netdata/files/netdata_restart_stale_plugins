#!/bin/bash
# Restart netdata when a package run replaced plugin binaries after the daemon
# started. Unpacking a plugin strips its file capabilities, and the plugin
# package's postinst restores them only after the netdata package's postinst
# has already restarted the daemon. Plugins spawned in that window keep empty
# capability sets until the next restart (go.d wireguard, systemd-journal and
# apps.plugin then silently lose data).
#
# Runs from apt's DPkg::Post-Invoke, after every package is configured.
set -euo pipefail

systemctl is-active --quiet netdata.service || exit 0

started=$(systemctl show netdata.service --property=ExecMainStartTimestamp --value --timestamp=unix)
stale=$(find /usr/libexec/netdata/plugins.d -maxdepth 1 -type f -newerct "$started" -print -quit)
[ -n "$stale" ] || exit 0

echo "netdata: $stale changed after the daemon started; restarting to apply plugin capabilities"
invoke-rc.d netdata restart
