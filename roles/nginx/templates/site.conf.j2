{# Jammy and Noble need the legacy listen parameter; newer nginx uses the
   http-scope `http2 on` in nginx.conf.j2. #}
{% set _http2_listen = ' http2' if ansible_distribution_release in ['jammy', 'noble'] else '' %}
server {
  listen              443 ssl{{ _http2_listen }};
{% if nginx_ipv6 %}
  listen              [::]:443 ssl{{ _http2_listen }};
{% endif %}
{% if _nginx_site_enable_http %}
  # Cleartext upstreams only; auth is rejected because its flow would be exposed.
  listen              80;
{% if nginx_ipv6 %}
  listen              [::]:80;
{% endif %}
{% endif %}

  server_name         {{ nginx_site_args.subdomain }}.{{ inventory_hostname }}.{{ domain }} {{ nginx_site_args.subdomain }}.{{ domain}};

  # A location with its own add_header inherits none from the server, so reuse
  # this block inside location / when location_conf is present.
{% set security_headers %}
  add_header X-XSS-Protection          "1; mode=block" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header Referrer-Policy           "same-origin" always;
{% if not (nginx_site_args.csp_passthrough | default(false)) %}
  add_header Content-Security-Policy   "{% if nginx_site_args.csp_additional is defined %}{{ nginx_site_args.csp_additional }}; {% endif %}default-src {% if nginx_site_args.csp_default_src is defined %}{{ nginx_site_args.csp_default_src }} {% endif %}{{ nginx_csp_default }}; frame-ancestors {% if nginx_site_args.csp_frame_ancestors is defined %}{{ nginx_site_args.csp_frame_ancestors }}{% else %}'self'{% endif %};" always;
{% endif %}
{# Opt out of the Topics API. #}
  add_header Permissions-Policy        "browsing-topics=()" always;
{# TLSRef/Mozilla Intermediate: two years, deliberately without preload. #}
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
{% endset %}
{{ security_headers }}

{% set _auth_enabled = _nginx_site_auth == 'required' %}
{% if _auth_enabled %}
  # Internal auth subrequest: 200 allows the request; 401 reaches the handler
  # below. The URL is host-configurable for remote Authelia access.
  location /internal/authelia {
    internal;
    proxy_pass {{ authelia_internal_url }};
    # Keep the per-request auth connection reusable.
    proxy_http_version 1.1;
    # Fail fast when remote Authelia is unreachable instead of using nginx's
    # 60-second defaults.
    proxy_connect_timeout 3s;
    proxy_send_timeout    5s;
    proxy_read_timeout    5s;
    # Authelia's redirect and identity headers can exceed nginx's default
    # subrequest buffers.
    proxy_buffer_size       32k;
    proxy_buffers           4 32k;
    client_body_buffer_size 128k;
    proxy_pass_request_body off;
    proxy_set_header Content-Length          "";
{% if _nginx_site_auth_request_authorization %}
    # Opt-in for machine clients using Authelia's HeaderAuthorization strategy.
    # The same helper option clears the credential from the protected upstream
    # leg below so callers cannot accidentally disclose the service password.
    proxy_set_header Authorization           $http_authorization;
{% else %}
    # App tokens belong to the upstream. Sending them to Authelia can turn a
    # valid session into a redirect loop; location / still forwards them.
    proxy_set_header Authorization           "";
{% endif %}
    # Do not relay a client-supplied hop-by-hop header.
    proxy_set_header Connection              "";
    proxy_set_header X-Original-Method       $request_method;
    proxy_set_header X-Original-URL          $scheme://$host$request_uri_safe;
    proxy_set_header X-Forwarded-For         $remote_addr;
    proxy_set_header X-Forwarded-Method      $request_method;
    proxy_set_header X-Forwarded-Proto       $scheme;
    proxy_set_header X-Forwarded-Host        $host;
    proxy_set_header X-Forwarded-Uri         $request_uri_safe;
  }

{% endif %}
  location / {
{% if _auth_enabled %}
    auth_request /internal/authelia;
    # Authelia sends Remote-User on every authenticated 200.
    auth_request_set $authelia_user $upstream_http_remote_user;
    # Preserve Authelia's portal target for navigation redirects.
    auth_request_set $redirection_url $upstream_http_location;
    # Only auth_request 401s reach this handler; upstream 401s pass through
    # because proxy_intercept_errors remains off.
    error_page 401 = @authelia_unauth;
{% endif %}
{% if nginx_site_args.proxy_pass is defined %}
    proxy_pass         {{ nginx_site_args.proxy_pass }};

    proxy_http_version 1.1;

    # Send SNI but accept the self-signed certificates used by LAN devices.
    proxy_ssl_server_name on;

    # Detect silently dropped LAN-device connections before the read timeout.
    proxy_socket_keepalive on;

    # Shared canonical forwarded headers.
    include /etc/nginx/snippets/proxy_params.conf;
{% if _auth_enabled %}
    # The *arr suite reads this when AuthenticationMethod=External.
    proxy_set_header X-Forwarded-User $authelia_user;
{% endif %}
{% if _nginx_site_auth_request_authorization %}
    # HeaderAuthorization credentials authenticate only the Authelia
    # subrequest; never disclose the reusable service password upstream.
    proxy_set_header Authorization      "";
{% endif %}

    proxy_connect_timeout 60s;
    proxy_send_timeout    {{ nginx_site_args.proxy_send_timeout | default('60s') }};
    proxy_read_timeout    {{ nginx_site_args.proxy_read_timeout | default('60s') }};
{% if nginx_site_args.proxy_buffering is defined %}
    proxy_buffering {{ nginx_site_args.proxy_buffering }};
{% endif %}
{% if nginx_site_args.proxy_request_buffering is defined %}
    proxy_request_buffering {{ nginx_site_args.proxy_request_buffering }};
{% endif %}
{% if nginx_site_args.client_max_body_size is defined %}
    client_max_body_size {{ nginx_site_args.client_max_body_size }};
{% endif %}
{% if nginx_site_args.client_body_buffer_size is defined %}
    client_body_buffer_size {{ nginx_site_args.client_body_buffer_size }};
{% endif %}
{% endif %}
{% if nginx_site_args.location_conf is defined %}
    # location_conf may add a header and suppress server-scope inheritance.
{{ security_headers }}

    {{ nginx_site_args.location_conf | trim | indent(4) }}
{% endif %}
  }
{% if _auth_enabled %}

  # Redirect navigations to Authelia, but return 401 to XHR/fetch to avoid SPA
  # redirect loops. nginx.conf.j2 derives the choice from Sec-Fetch-Mode; this
  # return-only if is safe and both responses inherit the security headers.
  location @authelia_unauth {
    if ($authelia_unauth_redirect) {
      return 302 $redirection_url;
    }
    return 401;
  }
{% endif %}
{% if nginx_site_args.server_conf is defined %}

  {{ nginx_site_args.server_conf | trim | indent(2) }}
{% endif %}
}
{% if not _nginx_site_enable_http %}

server {
    listen      80;
{% if nginx_ipv6 %}
    listen      [::]:80;
{% endif %}
    server_name {{ nginx_site_args.subdomain }}.{{ inventory_hostname }}.{{ domain }} {{ nginx_site_args.subdomain }}.{{ domain}};

    return 308 https://$host$request_uri;
}
{% endif %}
