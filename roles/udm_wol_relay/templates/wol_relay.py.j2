#!/usr/bin/env python3
"""Relay Wake-on-LAN magic packets from selected VLANs to target VLAN broadcasts."""

from __future__ import annotations

import ipaddress
import logging
import select
import socket
import sys


LISTEN_PORT = {{ udm_wol_relay_port | to_json }}
BIND_ADDRESSES = {{ udm_wol_relay_source_gateways | to_json }}
ALLOWED_SOURCES = [ipaddress.ip_network(cidr) for cidr in {{ udm_wol_relay_source_cidrs | to_json }}]
TARGET_BROADCASTS = {{ udm_wol_relay_target_broadcasts | to_json }}

# UniFi OS ships Python 3.9, whose socket module does not expose IP_FREEBIND;
# 15 is its value in linux/in.h. FREEBIND lets the qemu test fixture bind
# gateway addresses the box does not own.
IP_FREEBIND = getattr(socket, "IP_FREEBIND", 15)
MAGIC_PACKET_LENGTH = 102


def is_allowed_source(host: str) -> bool:
    address = ipaddress.ip_address(host)
    return any(address in network for network in ALLOWED_SOURCES)


def is_magic_packet(payload: bytes) -> bool:
    # Strict prefix match: every real sender puts the packet at offset 0. The
    # payload[6:12] exclusion rejects an all-0xff pseudo-packet (broadcast MAC
    # is not a wakeable NIC).
    return (
        len(payload) >= MAGIC_PACKET_LENGTH
        and payload[:6] == b"\xff" * 6
        and payload[6:12] != b"\xff" * 6
        and payload[6:MAGIC_PACKET_LENGTH] == payload[6:12] * 16
    )


def check_config() -> None:
    if LISTEN_PORT < 1 or LISTEN_PORT > 65535:
        raise SystemExit(f"invalid listen port: {LISTEN_PORT}")
    if not BIND_ADDRESSES or not ALLOWED_SOURCES or not TARGET_BROADCASTS:
        raise SystemExit("bind addresses, allowed sources, and target broadcasts are all required")
    for host in BIND_ADDRESSES + TARGET_BROADCASTS:
        ipaddress.ip_address(host)
    # A target broadcast inside an allowed source network would let the relay
    # re-ingest its own rebroadcasts in a tight loop: refuse at config time.
    for target in TARGET_BROADCASTS:
        if is_allowed_source(target):
            raise SystemExit(f"target broadcast {target} lies inside an allowed source network")
    print(
        "listening on %s; allowing %s; relaying to %s"
        % (
            ", ".join("%s:%d" % (address, LISTEN_PORT) for address in BIND_ADDRESSES),
            ", ".join(str(network) for network in ALLOWED_SOURCES),
            ", ".join("%s:%d" % (target, LISTEN_PORT) for target in TARGET_BROADCASTS),
        )
    )


def serve() -> None:
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    check_config()
    listeners = []
    for address in BIND_ADDRESSES:
        listener = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        listener.setsockopt(socket.IPPROTO_IP, IP_FREEBIND, 1)
        listener.bind((address, LISTEN_PORT))
        listeners.append(listener)
    sender = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sender.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    logging.info(
        "wol relay listening on %s",
        ", ".join("%s:%d" % (address, LISTEN_PORT) for address in BIND_ADDRESSES),
    )
    while True:
        readable, _, _ = select.select(listeners, [], [])
        for listener in readable:
            payload, (source_host, source_port) = listener.recvfrom(2048)
            if not is_allowed_source(source_host):
                continue
            if not is_magic_packet(payload):
                continue
            # Rebroadcast a normalized packet, never the raw payload: the
            # relay moves exactly one magic packet across the VLAN boundary,
            # not arbitrary trailing bytes.
            packet = payload[:MAGIC_PACKET_LENGTH]
            sent = 0
            for target in TARGET_BROADCASTS:
                try:
                    sender.sendto(packet, (target, LISTEN_PORT))
                    sent += 1
                except OSError as error:
                    # A down target interface must not kill relaying to the
                    # healthy ones (or crash-loop the daemon).
                    logging.warning("send to %s:%d failed: %s", target, LISTEN_PORT, error)
            logging.info(
                "relayed magic packet from %s:%d to %d target broadcast(s)",
                source_host,
                source_port,
                sent,
            )


def main() -> None:
    if len(sys.argv) == 2 and sys.argv[1] == "--check-config":
        check_config()
        return
    if len(sys.argv) != 1:
        raise SystemExit("usage: wol_relay.py [--check-config]")
    serve()


if __name__ == "__main__":
    main()
