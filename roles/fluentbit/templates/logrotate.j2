/var/log/fluent-bit/lnav.jsonl {
    daily
    rotate 14
    size 200M
{% if zfs_root %}
    # compress
{% else %}
    compress
    delaycompress
{% endif %}
    missingok
    notifempty
    # fluent-bit reopens the path on every flush, so it moves to the new file
    # without a restart.
    create 0640 root adm
    su root adm
}
