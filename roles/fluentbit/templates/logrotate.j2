/var/log/fluent-bit/lnav.jsonl {
    daily
    rotate 14
    size 200M
{% if zfs_root %}
    # compress
{% else %}
    compress
    delaycompress
{% endif %}
    missingok
    notifempty
    # systemd holds the file open with O_APPEND for the daemon lifetime, so
    # truncating in place keeps fluent-bit writing to the live path without a
    # restart, which would drop its in-memory backlog.
    copytruncate
    su root adm
}
