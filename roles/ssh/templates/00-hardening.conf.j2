# Load only the fleet's persisted Ed25519 host identity.
HostKey /etc/ssh/ssh_host_ed25519_key

MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com

# AuthenticationMethods requires public-key authentication to remain enabled.
PubkeyAuthentication yes
# Accept fleet Ed25519 keys and hardware-backed Ed25519 security keys.
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com
AuthenticationMethods publickey

# Record the accepted key fingerprint for attribution.
LogLevel VERBOSE

# Record SFTP file operations that do not appear in the session log.
Subsystem sftp  internal-sftp -f AUTHPRIV -l INFO

# Require an attributable operator session before privilege escalation.
PermitRootLogin no

# Reject password and keyboard-interactive authentication.
PasswordAuthentication no
KbdInteractiveAuthentication no
# X11 forwarding is disabled globally; the lab host renders a user-scoped
# override below so other accounts remain unaffected.
X11Forwarding no

# Key-only login needs little unauthenticated connection time.
LoginGraceTime 30

# Probe idle transports and reap vanished clients after about 15 minutes.
ClientAliveInterval 300
ClientAliveCountMax 3

# Replace stale RemoteForward sockets used by GPG forwarding.
StreamLocalBindUnlink yes

{% if ssh_x11_forwarding | default(false) %}
# IPv6 loopback is disabled here; use IPv4 so X11 setup does not stop at ::1.
AddressFamily inet

Match User {{ operator_user }}
    X11Forwarding yes
{% endif %}
