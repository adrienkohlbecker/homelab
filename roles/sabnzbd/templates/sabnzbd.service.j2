#jinja2: lstrip_blocks: True
# sabnzbd.service #######################################################################
[Unit]
Description=sabnzbd
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
{% if zfs_has_scratch_mount %}
After=zfs_mount_mnt_scratch.service
Requires=zfs_mount_mnt_scratch.service
{% endif %}
{% if zfs_has_media_mount %}
After=zfs_mount_mnt_media.service
Requires=zfs_mount_mnt_media.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
TimeoutStartSec=180
# Exceed the container's `--stop-timeout 120` so systemd doesn't SIGKILL the
# cgroup at the moment podman's graceful-stop window closes -- that race would
# truncate SABnzbd's history database flush.
TimeoutStopSec=150
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

# Routine connection lifecycle records add no state. Preserve warnings,
# failures, and TLS records without negotiated-cipher confirmation.
LogFilterPatterns=~[[](downloader|newswrapper):[0-9]+[]] ([0-9]+@[^: ]+: (Initiating connection|Connected using TLSv[0-9.]+ [(][^)]+[)])|Connecting [0-9]+@[^ ]+ finished)[[:space:]]*$

ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name sabnzbd \
    --security-opt=no-new-privileges \
    --log-driver journald \
    --log-opt tag="sabnzbd" \
    --env PUID={{ sabnzbd_user.uid }} \
    --env PGID={{ media_group.gid }} \
    --env UMASK=002 \
    --env TZ={{ system_timezone }} \
    --volume /mnt/services/sabnzbd:/config \
    --volume /mnt/media/Other:/media/Other \
    --volume /mnt/scratch/sabnzbd:/scratch/sabnzbd \
    --volume /mnt/scratch/sonarr:/scratch/sonarr \
    --volume /mnt/scratch/radarr:/scratch/radarr \
    --volume /mnt/scratch/lidarr:/scratch/lidarr \
    --network media \
    --publish 127.0.0.1:{{ service_ports.sabnzbd }}:8080/tcp \
    --health-cmd         {{ "http://localhost:8080/api?mode=version" | podman_health_curl }} \
    --health-startup-cmd {{ "http://localhost:8080/api?mode=version" | podman_health_curl }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "100s" \
    --stop-timeout 120 \
    {{ sabnzbd_image }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
{% if zfs_root %}
WantedBy=zfs_autosnapshot.target
{% endif %}
