#!/bin/bash
set -euo pipefail
((EUID == 0)) || {
  echo >&2 "Error: I require root"
  exit 1
}

failed=0
run_step() {
  "$@" || {
    local retval=$?
    echo >&2 "Error:$(printf ' %q' "$@") failed with exit $retval"
    ((failed += 1))
  }
}

# No argument: the nightly local leg, snapshotting this host's datasets.
# --pull: the nightly onsite leg, from its own later timer once every host has
# snapshotted: pull each source host's snapshots onto this host.
# --final: quiesce mode for the rebuild runbooks. Runs both legs but leaves
# zfs_autosnapshot.target stopped afterwards, so no state writer restarts
# between the final snapshot and the host being wiped/restored.
snapshot=1
pull=0
zfs_backup_local_args=()
case "${1:-}" in
  '') ;;
  --pull) snapshot=0 pull=1 ;;
  --final) pull=1 zfs_backup_local_args=(--no-resume) ;;
  *)
    echo >&2 "Usage: zfs_autosnapshot [--pull | --final]"
    exit 2
    ;;
esac

# Gate offsite replication on the local snapshot succeeding. The offsite leg
# rsyncs from this host's just-taken @bak- snapshots and picks the newest @bak-
# per dataset independently (zfs_backup_offsite.sh). A partial local backup
# failure can leave some datasets at tonight's @bak- and others still at last
# night's -- replicating that now would
# push a cross-dataset generation skew offsite, overwriting the previous,
# consistent copy with a mixed one. So if the local step failed at all, skip
# offsite and let the next run retry from a clean snapshot. (`failed` is already
# bumped, so the run still exits 1 below for monitoring.) A pull-only run takes
# no snapshot and so ships nothing offsite.
zfs_backup_local_ok=0
if ((snapshot)); then
  run_step zfs_backup_local "${zfs_backup_local_args[@]}"
  zfs_backup_local_ok=$((failed == 0))
fi

# pull each configured source host's snapshots onto this host
# Unaffected by the gate above: each onsite leg pulls a *peer* host's own
# snapshots (--no-snapshot --ssh-source), not the ones taken locally this run,
# so a local-snapshot failure here doesn't make these copies inconsistent.
{% if zfs_autobackup_sources %}
if ((pull)); then
{% for src in zfs_autobackup_sources %}
  run_step zfs_backup_onsite "{{ external_ips[src.host] }}" "{{ src.dest_dataset }}"
{% endfor %}
fi
{% endif %}

# Offsite sync is paused while bunk is unavailable.
# sync each dataset to offsite synology
# if ((zfs_backup_local_ok)); then
#   for dataset in $(zfs get 'autobackup:bak' -t filesystem -H -s local -o name,value | awk -v FS='\t' '$2=="true" {print $1}'); do
#     offsite_failed_before=$failed
#     run_step zfs_backup_offsite "{{ external_ips.bunk }}" "$dataset"
#     # If this dataset failed, bunk rrsync receiver may still hold the per-host
#     # fcntl flock for the second or two it takes to notice the dropped
#     # connection. Pause before the next dataset so it does not trip "Another
#     # instance of rrsync is already accessing this directory" -- a code-12 abort
#     # that would lose an otherwise-healthy dataset. Only on failure: a clean
#     # transfer has already released the lock before the next iteration starts.
#     if ((failed != offsite_failed_before)); then
#       sleep 10
#     fi
#   done
# else
#   echo >&2 "Error: local snapshot step failed; skipping offsite replication to avoid pushing a cross-dataset generation skew over last night's consistent copy"
# fi

# fail if any of the above failed
if ((failed != 0)); then
  echo >&2 "Error: Some backup steps have failed"
  exit 1
fi

echo "Done"
