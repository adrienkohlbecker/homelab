# SSH client config for zfs_autobackup's onsite and offsite transports.
# ControlMaster is load-bearing -- zfs-autobackup opens many short ssh connections
# per run and multiplexes them over one master.
# ZFS streams are already compressed; prefer hardware-accelerated AES-GCM while
# retaining OpenSSH's remaining configured ciphers as fallbacks.
Host *
    BatchMode yes
    Ciphers ^aes128-gcm@openssh.com
    Compression no
    ControlPath ~/.ssh/.controlmaster-%C
    ControlMaster auto
    ControlPersist 300
    ForwardAgent no
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    PreferredAuthentications publickey
    ServerAliveCountMax 2
    ServerAliveInterval 30
    ConnectTimeout 10
