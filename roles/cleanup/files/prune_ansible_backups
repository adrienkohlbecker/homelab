#!/bin/bash
# Prune Ansible <name>.<pid>.<timestamp>~ backups by filename timestamp. Ansible
# preserves the original file's mtime, so find -mtime could delete a new backup.
#
# Defaults cover the root filesystem and the separate services dataset. -xdev
# keeps scans out of data pools and container storage; `.zfs` is pruned
# explicitly. Arguments override the roots so verification can scope the scan.
set -euo pipefail

RETENTION_DAYS=7

roots=("$@")
[ "${#roots[@]}" -eq 0 ] && roots=(/ /mnt/services)

# A host may lack /mnt/services; find errors on a missing start path.
present=()
for r in "${roots[@]}"; do [ -d "$r" ] && present+=("$r"); done
[ "${#present[@]}" -eq 0 ] && exit 0

cutoff=$(date -d "${RETENTION_DAYS} days ago" +%s)

while IFS= read -r -d '' f; do
  ts=${f%\~}
  ts=${ts##*.}
  epoch=$(date -d "${ts/@/ }" +%s 2>/dev/null) || continue
  if [ "$epoch" -lt "$cutoff" ]; then
    rm -f -- "$f"
  fi
done < <(
  find "${present[@]}" -xdev -name .zfs -prune -o \
    -type f -regextype posix-extended \
    -regex '.*\.[0-9]+\.[0-9]{4}-[0-9]{2}-[0-9]{2}@[0-9]{2}:[0-9]{2}:[0-9]{2}~$' -print0
)
