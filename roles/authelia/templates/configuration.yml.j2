# {{ ansible_managed }}
# Runtime secrets use *_FILE environment variables except the inline OIDC
# issuer key documented below. The service mounts the containing directory at
# /config, which also stores SQLite state and password updates.
---
theme: 'auto'
# server.address is the listen socket inside the container; nginx on
# the host proxies https://auth.{{ authelia_cookie_domain }} → 127.0.0.1:{{ service_ports.authelia }}.
server:
  address: 'tcp://:9091'

log:
  level: 'info'
  # Journald already supplies the transport envelope. JSON keeps Authelia's
  # method, path, remote_ip, error, and flow metadata machine-readable on
  # stdout so the service-owned Fluent Bit normalizer can remove only the
  # duplicate timestamp and severity fields.
  format: 'json'

totp:
  issuer: '{{ authelia_cookie_domain }}'

# Identity verification: drives the JWT used in reset-password emails.
identity_validation:
  # AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE supplies the secret.
  reset_password: {}

authentication_backend:
  file:
    path: '/config/users.yml'
    watch: true

# Access control: default_policy deny, so any subdomain not matched
# below is refused outright. Every authenticated user -- operator and
# household alike -- gets two_factor on every protected subdomain. The
# sole one_factor exception is Homepage's non-interactive service account,
# limited by group intersection, source address, Netdata domains, and two
# read-only API paths. Human-facing access remains covered by the wildcard
# two_factor rule. That requirement is also the UX trigger that unlocks the
# TOTP/WebAuthn enrollment buttons in the portal -- Authelia hides them unless
# some rule requires a 2nd factor.
access_control:
  default_policy: 'deny'
  rules:
    - domain:
{% for host in homepage_netdata_hosts %}
        - 'netdata.{{ host }}.{{ domain }}'
{% endfor %}
      resources:
        - '^/api/v1/alarms([/?].*)?$'
        - '^/api/v2/alert_transitions([/?].*)?$'
      subject:
        -
          - 'group:netdata'
          - 'group:service'
      networks:
        - '{{ network.hosts.lab.physical }}/32'
        - '{{ network.hosts.lab.wireguard }}/32'
        - '{{ network.hosts.lab.tailscale }}/32'
{% if qemu_test %}
        - '127.0.0.1/32'
{% endif %}
      policy: 'one_factor'
    - domain: '*.{{ authelia_cookie_domain }}'
      policy: 'two_factor'

session:
  inactivity: '4h'
  expiration: '24h'
  cookies:
    - domain: '{{ authelia_cookie_domain }}'
      authelia_url: 'https://auth.{{ authelia_cookie_domain }}'
      default_redirection_url: 'https://homepage.{{ inventory_hostname }}.{{ domain }}/'

# Brute-force regulation: 5 failed attempts in 2 min → 5 min lockout.
# Per-user (not per-IP) so a single misbehaving client doesn't
# trigger a lockout on the user's behalf.
regulation:
  max_retries: 5
  find_time: '2m'
  ban_time: '5m'

storage:
  local:
    path: '/config/db.sqlite3'

# Authelia checks the system clock against an NTP server at startup and
# fatals if it is not synchronized accurately enough -- accurate time is
# load-bearing for TOTP and short-lived tokens. The qemu test fixture has
# no working NTP sync (chrony can't reach upstream over SLIRP UDP, so the
# clock is never marked synchronized), which fails the check on every
# boot; skip it there. Kept on for prod, where a drifting clock would
# silently break TOTP and should surface loudly at startup rather than as
# mysterious auth failures later.
ntp:
  disable_startup_check: {% if qemu_test %}true{% else %}false{% endif %}

notifier:
  # Notification failures surface when identity verification sends mail;
  # transient SMTP or DNS failures must not block the authentication gate.
  disable_startup_check: true

  smtp:
    address: 'submission://{{ smtp_host }}:{{ smtp_port }}'
    timeout: '5s'
    username: 'authelia@{{ email_domain }}'
    sender: 'Authelia <authelia@{{ email_domain }}>'
    identifier: '{{ inventory_hostname }}.{{ domain }}'
    subject: '[Authelia] {title}'
    startup_check_address: '{{ root_email }}'

# OIDC is independent of forward-auth and serves authelia_oidc_clients.
identity_providers:
  oidc:
    # The HMAC secret is mounted through *_FILE. Authelia v4.39 requires the
    # RSA signing key inline and derives its public /jwks.json entry at startup.
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          {{ authelia_oidc_issuer_private_key | indent(width=10) }}
    # Discovery and JWKS are consumed server-to-server, so no CORS policy is
    # needed. Some clients read groups only from the ID token; this opt-in
    # policy promotes the claims they need from userinfo.
    claims_policies:
      jwt_groups:
        id_token:
          - groups
          - email
          - email_verified
    clients:
{% for client in authelia_oidc_clients %}
      - client_id: '{{ client.client_id }}'
        client_name: '{{ client.client_name }}'
        # Authelia expects the hash; the consumer owns the plaintext half.
        client_secret: '{{ client.client_secret }}'
        public: false
        authorization_policy: 'two_factor'
        claims_policy: 'jwt_groups'
        # Pre-configure consent for a year so first-party clients
        # don't show the Authorize prompt on every login (single-
        # operator homelab; explicit consent is theatre here).
        consent_mode: 'pre-configured'
        pre_configured_consent_duration: '1y'
        require_pkce: false
        redirect_uris:
{% for uri in client.redirect_uris %}
          - '{{ uri }}'
{% endfor %}
        scopes:
          - 'openid'
          - 'email'
          - 'profile'
          - 'groups'
        grant_types:
          - 'authorization_code'
        response_types:
          - 'code'
{% if client.token_endpoint_auth_method is defined %}
        token_endpoint_auth_method: '{{ client.token_endpoint_auth_method }}'
{% endif %}
        userinfo_signed_response_alg: 'none'
{% endfor %}
