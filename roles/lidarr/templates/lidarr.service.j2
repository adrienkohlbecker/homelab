#jinja2: lstrip_blocks: True
[Unit]
Description=lidarr
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
{% if zfs_root %}
{% if zfs_has_services_mount %}
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
{% if zfs_has_scratch_mount %}
After=zfs_mount_mnt_scratch.service
Requires=zfs_mount_mnt_scratch.service
{% endif %}
{% if zfs_has_media_mount %}
After=zfs_mount_mnt_media.service
Requires=zfs_mount_mnt_media.service
{% endif %}
After=zfs_autosnapshot.target
PartOf=zfs_autosnapshot.target
{% endif %}

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
Delegate=yes
TimeoutStartSec=120
# Exceed the container timeout so Lidarr can write config.xml before systemd
# reaches its stop deadline.
TimeoutStopSec=180
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

ExecStartPre=/bin/rm -f %t/%n.ctr-id
# Lidarr listens on fixed container port 8686; service_ports controls only the
# published host port.
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name lidarr \
    --security-opt=no-new-privileges \
    --log-driver journald \
    --log-opt tag="lidarr" \
    --env PUID={{ lidarr_user.uid }} \
    --env PGID={{ media_group.gid }} \
    --env UMASK=002 \
    --env TZ={{ system_timezone }} \
    --volume /mnt/services/lidarr:/config \
    --volume /mnt/media:/media \
    --volume /mnt/scratch/lidarr:/scratch/lidarr \
    --network media \
    --publish 127.0.0.1:{{ service_ports.lidarr }}:8686/tcp \
    --health-cmd         {{ "http://localhost:8686/ping" | podman_health_curl }} \
    --health-startup-cmd {{ "http://localhost:8686/ping" | podman_health_curl }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "100s" \
    --stop-timeout 120 \
    {{ lidarr_image }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
{% if zfs_root %}
WantedBy=zfs_autosnapshot.target
{% endif %}
