[Unit]
# KVM and system tuners can disable the kernel's default-on detector after
# boot. The paired timer re-asserts it once after boot. KVM can expose the
# sysctl without a usable perf PMU, so require the kernel's CPU event source.
Description=Re-arm NMI hard-lockup watchdog after KVM bring-up disables it
ConditionPathExists=/proc/sys/kernel/nmi_watchdog
ConditionPathExistsGlob=/sys/bus/event_source/devices/cpu*

[Service]
Type=oneshot
SyslogIdentifier=kdump_nmi_watchdog
ExecStart=/sbin/sysctl -q -w kernel.nmi_watchdog=1
