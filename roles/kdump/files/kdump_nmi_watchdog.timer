[Unit]
# KVM disables the watchdog asynchronously, so ordering after qemu-kvm.service
# still races the teardown. A fixed delay clears it; the shared stem selects
# kdump_nmi_watchdog.service automatically.
Description=Re-arm NMI hard-lockup watchdog after KVM bring-up timer

[Timer]
OnBootSec=3min

[Install]
WantedBy=timers.target
