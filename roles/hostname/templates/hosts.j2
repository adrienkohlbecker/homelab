127.0.0.1 localhost
{# Keep the FQDN in DNS: Podman copies /etc/hosts into containers, where a #}
{# 127.0.1.1 FQDN entry would point back at each container. #}
127.0.1.1 {{ inventory_hostname }}

# The following line is desirable for IPv6 capable hosts
::1 localhost ip6-localhost ip6-loopback
{% if etc_hosts_entries %}

# Static overrides for hosts that cannot use regular DNS. This map also drives
# roles/adguard's container --add-host flags.
{% for host, ip in etc_hosts_entries.items() %}
{{ ip }} {{ host }}
{% endfor %}
{% endif %}
