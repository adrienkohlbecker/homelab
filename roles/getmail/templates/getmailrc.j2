[retriever]
type = SimpleIMAPSSLRetriever
server = imap.gmail.com
port = 993
username = {{ root_email }}
# Normalize Gmail's displayed four-group password format and vault newlines.
password = {{ gmail_app_password | trim | replace(' ', '') }}
# Require system CA validation and the Gmail hostname; leave TLS version
# negotiation to Python's client defaults.
ca_certs = /etc/ssl/certs/ca-certificates.crt
ssl_cert_hostname = imap.gmail.com
# Preserve Gmail's read/unread state even if the upstream default changes.
use_peek = true
record_mailbox = false
# Gmail localizes folder names; if fetching is empty, confirm the UI language.
mailboxes = ("[Gmail]/All Mail",)

[destination]
type = Maildir
path = /mnt/services/getmail/

[options]
read_all = false
delivered_to = false
received = false
