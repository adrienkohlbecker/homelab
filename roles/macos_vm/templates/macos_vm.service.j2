[Unit]
Description=macOS VM {{ macos_vm_name }}
After=zfs-volumes.target
{% if zfs_root %}
After=zfs_mount_var_lib_macos_vm.service
Requires=zfs_mount_var_lib_macos_vm.service
{% endif %}
StartLimitIntervalSec=0

[Service]
RuntimeDirectory=macos-vm
WorkingDirectory={{ macos_vm_workdir }}
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
TimeoutStopSec=45
{% if macos_vm_install_mode %}
Environment=TMPDIR={{ macos_vm_workdir }}
{% endif %}
ExecStart={% if macos_vm_cpu_pinset | length > 0 %}/usr/bin/taskset -c {{ macos_vm_cpu_pinset }} {% endif %}/usr/bin/qemu-system-x86_64 \
  -enable-kvm \
  -m {{ macos_vm_memory_mib }} \
  -cpu Penryn,kvm=on,vendor=GenuineIntel,+invtsc,vmware-cpuid-freq=on,+ssse3,+sse4.2,+popcnt,+avx,+aes,+xsave,+xsaveopt,check \
{# Versioned, not the moving q35 alias: macOS sees the machine model as
   hardware, so QEMU upgrades must not change it implicitly. 8.2 is Noble's
   q35 and remains available on Resolute. QEMU deprecates versioned machine
   types after three years and removes them after six; _verify.yml fails on
   the deprecation warning, so a bump, which the guest sees as new hardware,
   must be deliberate. #}
  -machine pc-q35-8.2 \
  -smp {{ macos_vm_vcpus }},cores={{ macos_vm_vcpus }},sockets=1,threads=1 \
  -device qemu-xhci,id=xhci \
  -device usb-kbd,id=kbd_xhci,bus=xhci.0 \
  -device usb-tablet,id=tablet_xhci,bus=xhci.0 \
  -device isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc \
  -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
  -drive if=pflash,format=raw,file={{ macos_vm_workdir }}/OVMF_VARS.fd \
  -smbios type=2 \
  -boot strict=on \
  -device ich9-ahci,id=sata \
  -drive id=OpenCoreBoot,if=none,format=qcow2,file={{ macos_vm_workdir }}/OpenCore.qcow2 \
  -device ide-hd,bus=sata.2,drive=OpenCoreBoot,bootindex=1 \
{% if macos_vm_install_mode %}
  -drive id=InstallMedia,if=none,file={{ macos_vm_workdir }}/BaseSystem.img,format=raw,snapshot=on \
  -device ide-hd,bus=sata.3,drive=InstallMedia,bootindex=3 \
{% endif %}
  -drive id=MacZvol,if=none,file={{ macos_vm_disk_source }},format=raw,cache=none,aio=native \
  -device ide-hd,bus=sata.4,drive=MacZvol,bootindex=2 \
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:{{ macos_vm_ssh_host_port }}-:22 \
  -device virtio-net-pci,netdev=net0,id=net0,mac={{ macos_vm_mac_address }} \
{# The keymap keeps AZERTY input aligned with macOS's French layout. VNC
   stays on loopback: reach it through an SSH tunnel. #}
  -k fr \
  -vnc 127.0.0.1:0 \
  -monitor unix:/run/macos-vm/{{ macos_vm_name }}.monitor,server=on,wait=off \
  -device vmware-svga

[Install]
WantedBy=multi-user.target
