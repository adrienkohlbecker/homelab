# Boot-time recovery leg for outages where no surviving host could send WoL.
[Unit]
Description=Wake NUT shutdown-ladder peers after boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Stay active after the boot run so a converge's `started` is a no-op
# rather than a re-broadcast (which could wake a peer the operator
# deliberately powered off).
RemainAfterExit=yes
ExecStart=/usr/local/bin/nut_notify wake_peers

[Install]
WantedBy=multi-user.target
