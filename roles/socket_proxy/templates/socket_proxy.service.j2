#jinja2: lstrip_blocks: True
# socket_proxy.service ################################################################
# Read-only Docker-API proxy in front of the rootful podman socket. netdata's
# go.d docker collector reads container metrics through this (tcp loopback)
# instead of granting Netdata direct socket access, so a compromise can't
# reach the container-create API. POST is denied by default (read-only); only
# the GET sections the collector needs are enabled (CONTAINERS/IMAGES/INFO;
# VERSION/PING are on by default; EVENTS is explicitly disabled). HAProxy logs
# only warnings and errors; routine API reads are intentionally omitted. The
# role-owned Fluent Bit extension normalizes those lifecycle and backend
# diagnostics. The proxy itself necessarily holds the socket access -- it is
# the deliberate isolation boundary, a tiny audited
# HAProxy rather than the full netdata daemon. No --user: the bind-mounted
# podman socket is root-owned (0660) and the proxy needs read access.
[Unit]
Description=socket_proxy
After=podman.socket
Requires=podman.socket
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
# HAProxy also emits a decorated copy with severity and process metadata.
LogFilterPatterns=~^Proxy (dockerfrontend|dockerbackend|docker-events) stopped [(]cumulated conns: FE: [0-9]+, BE: [0-9]+[)][.][[:space:]]*$
Environment=PODMAN_SYSTEMD_UNIT=%n
Delegate=yes
Restart=always
TimeoutSec=120
RestartSec=5
Type=notify
NotifyAccess=all
SyslogIdentifier=%N

ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --sdnotify=healthy \
    --detach \
    --replace \
    --rm \
    --name socket_proxy \
    --security-opt=no-new-privileges \
    --network socket_proxy \
    --log-driver journald \
    --log-opt tag="socket_proxy" \
    --volume /run/podman/podman.sock:/var/run/docker.sock:ro \
    --env CONTAINERS=1 \
    --env IMAGES=1 \
    --env INFO=1 \
    --env EVENTS=0 \
    --env POST=0 \
    --env DISABLE_IPV6=1 \
    --env LOG_LEVEL=warning \
    --publish 127.0.0.1:{{ service_ports.socket_proxy }}:2375/tcp \
    --health-cmd {{ ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2375/version"] | json_argv }} \
    --health-startup-cmd {{ ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2375/version"] | json_argv }} \
    --health-startup-interval "1s" \
    --health-startup-timeout "5s" \
    --health-start-period "30s" \
    --stop-timeout 30 \
    {{ socket_proxy_image }}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/%n.ctr-id

[Install]
WantedBy=multi-user.target
