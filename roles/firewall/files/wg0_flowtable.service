# Attach wg0 dynamically so nftables can load before the interface exists.
#
# PartOf reapplies the attachment after either parent restarts.
# nftables.service's ExecReload handles reloads, which PartOf does not.
#
# WantedBy starts this unit with wg-quick without making a direct start
# pull in wg-quick as a Requires-style dependency would.
#
# Silently skip when wg0 is absent; the condition is re-evaluated when
# wg-quick next starts.
[Unit]
Description=Attach wg0 to nftables homelab flowtable
After=wg-quick@wg0.service nftables.service
PartOf=wg-quick@wg0.service nftables.service
ConditionPathExists=/sys/class/net/wg0

[Service]
Type=oneshot
RemainAfterExit=yes
# nft 1.0.9 requires the existing hook and priority to be restated when
# merging wg0 into the flowtable's device set.
ExecStart=/usr/sbin/nft add flowtable inet homelab bulk { hook ingress priority filter; devices = { wg0 }; }

[Install]
WantedBy=wg-quick@wg0.service
