#!/usr/sbin/nft -f

# Central definitions keep repeated values parse-time checked.
define WAN_IFACE = "{{ default_interface }}"
define HOME_LAN = {{ network.sites.home.cidr }}
define WG_SUBNET = {{ network.partitions.wireguard.cidr }}
define PODMAN_DEFAULT = {{ podman_default_network }}
define PODMAN_POOL = {{ podman_bridge_pool }}
{% set samba_exposed = (samba_shares | default([]) | length) > 0 %}

# Replace only this table; netavark's tables in the same ruleset stay
# untouched. Delete and recreate it so constant sets do not retain stale
# ifindexes; the batch stays atomic under `nft -f`.
#
# The `inet` family means v6 packets enter this table wherever IPv6 is
# enabled (see firewall_disable_ipv6): port- and interface-only rules
# still apply, and the IPv4-only address matches fall through to the
# policy drop instead of bypassing the filter.
add table inet homelab
delete table inet homelab
table inet homelab {

    # Named counters give functional probes stable JSON identities
    # independent of rule comments and ordering.
    counter input_nonsyn {}
    counter input_silenced {}
    counter input_catchall {}
    counter input_catchall_reset {}
    counter vrrp_accept {}
    counter aardvark_accept {}
    counter aardvark_tcp_accept {}
    counter mdns_accept {}
    counter igmp_accept {}
    counter wireguard_accept {}
    counter input_admin {}
    counter forward_podman_isolation {}
    counter forward_authelia_wg {}
    counter forward_authelia_drop {}
    counter forward_nonsyn {}
    counter forward_catchall {}
    counter input_public_tcp {}
    counter input_nut_podman {}
    counter input_loopback {}
    counter input_icmp_accept {}
{% if tailscale_advertise_routes is defined %}
    counter tailscale_input_accept {}
    counter tailscale_forward_accept {}
{% endif %}
{% if tailscale_wan_direct | default(false) %}
    counter tailscale_underlay_accept {}
{% endif %}
{% if dns_vrrp_enabled %}
    counter input_silenced_vip_tcp {}
    counter input_silenced_vip {}
    counter forward_silenced_vip {}
{% endif %}

    # Admin services require an (iif, saddr) pair, not a union of the two:
    # home-LAN sources must arrive on the WAN iface (also the LAN iface
    # behind the UDM) and wireguard sources on wg0.
    set lan_admin_pairs {
        typeof iifname . ip saddr
        flags interval, constant
        elements = {
            $WAN_IFACE . $HOME_LAN comment "home LAN via WAN iface",
            "wg0" . $WG_SUBNET comment "wireguard peer via wg0",
        }
    }

    # Services reachable only through lan_admin_pairs.
    set lan_admin_services {
        type inet_proto . inet_service
        flags interval, constant
        elements = {
            udp . 60000-61000 comment "Mosh",
{% if samba_exposed %}
            tcp . 445 comment "Samba",
{% endif %}
            tcp . {{ service_ports.nut }} comment "NUT",
{% if tailscale_wan_direct | default(false) %}
            udp . {{ tailscale_port }} comment "Tailscale direct endpoint",
{% endif %}
        }
    }

    # Trusted ingress for reaching published containers and for the
    # catch-all TCP reset, so a future guest VLAN or bridge stays out.
    # vrrp.<vrid> is keepalived's use_vmac child of $WAN_IFACE: DNS to
    # the VIP enters there before PREROUTING DNAT, on the same L2.
    set lan_admin_ifaces {
        type ifname
        flags constant
        elements = {
            $WAN_IFACE comment "WAN-facing iface (LAN saddrs arrive via UDM)",
            "wg0" comment "wireguard tunnel",
{% if dns_vrrp_enabled %}
            "vrrp.{{ dns_keepalived_vrid }}" comment "keepalived vmac (DNS VIP carrier; same L2 as $WAN_IFACE)",
{% endif %}
        }
    }

    # Established TCP/UDP flows ingressing on a listed device skip the
    # forward chain, which cuts CPU on bulk traffic. Only $WAN_IFACE is
    # static: a missing device fails the whole load with ENOENT, so
    # wg0_flowtable.service attaches wg0 once it exists. Podman bridges
    # cannot be wildcarded and stay on the slow path.
    flowtable bulk {
        hook ingress priority filter;
        devices = { $WAN_IFACE };
    }

    ##################################################
    #                   INPUT CHAIN                  #
    ##################################################
    chain input {
        type filter hook input priority filter; policy drop;

        # Established/related and loopback unconditionally; INVALID
        # dropped. Every remaining packet is NEW, so no rule below needs
        # a ct-state qualifier.
        ct state established,related accept
        iifname "lo" counter name "input_loopback" accept
{% if tailscale_advertise_routes is defined %}

        # Trust decapsulated, ACL-gated tailnet traffic. Mirror tailscaled's
        # ts-input accept because a drop in any input base chain wins. iifname
        # lets the ruleset load before tailscaled creates the interface.
        iifname "tailscale0" counter name "tailscale_input_accept" accept comment "tailscale mesh (tailnet ingress)"
{% endif %}
        ct state invalid drop

        # TCP NEW must have SYN. Conntrack's loose mode (default)
        # classifies mid-stream non-SYN packets as NEW rather than
        # INVALID, so without this an attacker could probe TCP
        # services with crafted ACKs.
        tcp flags & (fin|syn|rst|ack) != syn counter name "input_nonsyn" drop comment "input non-syn drop"

        # DNS allows. Source-scope what doesn't need WAN reach: 5333 is
        # container DNS (aardvark-dns, consumers live on podman bridges);
        # 5353 mDNS is link-local on the home LAN. aardvark-dns binds
        # the gateway IP of every DNS-enabled named bridge allocated from
        # podman_bridge_pool, so both source ranges are required. TCP
        # carries the truncated-answer fallback: aardvark-dns 1.12+ serves
        # it and netavark DNATs both protocols to 5333, but netavark's
        # accept-policy INPUT chain cannot override this chain's policy drop.
        ip saddr { $PODMAN_DEFAULT, $PODMAN_POOL } udp dport 5333 counter name "aardvark_accept" accept comment "aardvark-dns (post-DNAT from gateway:53, all podman bridges)"
        ip saddr { $PODMAN_DEFAULT, $PODMAN_POOL } tcp dport 5333 counter name "aardvark_tcp_accept" accept comment "aardvark-dns TCP fallback (post-DNAT from gateway:53, all podman bridges)"
        iifname $WAN_IFACE ip saddr $HOME_LAN udp dport 5353 counter name "mdns_accept" accept comment "mDNS (home LAN)"

        # IGMP is link-local (TTL=1) and required for hosts to answer the
        # LAN snooping querier for groups they joined.
        ip protocol igmp counter name "igmp_accept" accept comment "IGMP (link-local group mgmt)"

        # Wireguard ingress only on the WAN iface.
        iifname $WAN_IFACE udp dport {{ service_ports.wireguard }} counter name "wireguard_accept" accept comment "wireguard (WAN ingress only)"
{% if tailscale_wan_direct | default(false) %}

        # A UniFi forward gives tailscaled a stable WAN underlay endpoint.
        # The tailscale0 rule sees only decapsulated inner traffic.
        iifname $WAN_IFACE udp dport {{ tailscale_port }} counter name "tailscale_underlay_accept" accept comment "tailscale direct endpoint (WAN underlay ingress)"
{% endif %}

        # Admin services only from the home LAN or wireguard; SSH, HTTP
        # and HTTPS are open to every source.
        iifname . ip saddr @lan_admin_pairs meta l4proto . th dport @lan_admin_services counter name "input_admin" accept comment "admin services (home LAN + wireguard)"
        tcp dport { 22, 80, 443 } counter name "input_public_tcp" accept comment "SSH, HTTP, HTTPS"

        # Home Assistant reaches NUT from a named podman bridge.
        #
        # Known gap: this trusts every container on every podman bridge,
        # and upsd exposes INSTCMD, so a compromised container could shut
        # the UPS down. Tightening needs HA's bridge subnet pinned here or
        # NUT clients restricted in upsd.users (home-environment trade).
        ip saddr $PODMAN_POOL tcp dport {{ service_ports.nut }} counter name "input_nut_podman" accept comment "nut (podman bridges, e.g. HA NUT integration)"

        # Only echo-request, rate-limited; other ICMP types arrive as
        # RELATED. Overflow falls through to the catch-all drop.
        icmp type echo-request limit rate 10/second burst 20 packets counter name "input_icmp_accept" accept

        # keepalived runs unicast with home-LAN peers. Scope VRRP to the
        # WAN iface and the named peers, not the whole HOME_LAN, so a
        # compromised LAN device cannot forge a higher-priority advert
        # and steal the DNS VIP.
{% if dns_vrrp_enabled %}
{% set vrrp_peer_ips = dns_keepalived_peers | reject('eq', inventory_hostname) | map('extract', external_ips) | list %}
{% if vrrp_peer_ips %}
        iifname $WAN_IFACE ip saddr { {{ vrrp_peer_ips | join(', ') }} } ip protocol vrrp counter name "vrrp_accept" accept comment "keepalived (VRRP, named peers only)"
{% endif %}
{% endif %}

        # Recurring benign LAN discovery noise, dropped before it can crowd
        # out real hits in the catch-all's rate-limited log.
        #   67      DHCP DISCOVER (the UDM is the DHCP server)
        #   137/138 NetBIOS broadcasts (nmbd is disabled; SMB uses 445)
        #   1900    SSDP/UPnP M-SEARCH
        #   10001   UniFi discovery broadcasts, every ~10s per VLAN
        #   57621   Spotify Connect LAN discovery
        # plus, on direct-endpoint hosts, Tailscale disco probes to the
        # tailscaled port from zones outside lan_admin_pairs.
        udp dport { 67, 137, 138, 1900, 10001, 57621{{ (', ' ~ tailscale_port) if tailscale_wan_direct | default(false) else '' }} } counter name "input_silenced" drop comment "input silenced LAN noise"
{% if dns_vrrp_enabled %}

        # DNS VIP traffic reaches INPUT only while netavark's AdGuard DNAT is
        # absent during a restart, plus unusable Tailscale probes to the
        # floating VIP. Keep TCP's catch-all RST so DoT clients fail over;
        # silently count the residual traffic without consuming log slots.
        iifname "vrrp.{{ dns_keepalived_vrid }}" ip daddr {{ network.virtual_ips.dns }} meta l4proto tcp counter name "input_silenced_vip_tcp" reject with tcp reset comment "DNS VIP leakage (resolver restart window)"
        iifname "vrrp.{{ dns_keepalived_vrid }}" ip daddr {{ network.virtual_ips.dns }} counter name "input_silenced_vip" drop comment "DNS VIP leakage (resolver restart + tailscale endpoint probes)"
{% endif %}

        # Catch-all: log+drop UDP and non-TCP/UDP protocols silently
        # to avoid ICMP amplification (every spoofed UDP probe would
        # otherwise echo an ICMP port-unreachable back to the spoofed
        # victim). TCP from a trusted iface (LAN / wg0) gets a RST so
        # admin tools fail fast; from WAN we silently drop so closed
        # ports don't confirm host existence to internet scanners.
        limit rate 5/minute burst 10 packets log prefix "[nftables] INPUT:DROP: "
        iifname @lan_admin_ifaces meta l4proto tcp counter name "input_catchall_reset" reject with tcp reset
        counter name "input_catchall" drop comment "input catch-all drop"
    }

    ##################################################
    #                  FORWARD CHAIN                 #
    ##################################################
    # Podman bridges match `podman*`: podman0 is the default bridge and
    # podman1+ the named bridges allocated from podman_bridge_pool.
    chain forward {
        type filter hook forward priority filter; policy drop;

        # Offload established flows; this packet still takes the accept
        # below, later ones skip the chain via the ingress hook.
        ip protocol { tcp, udp } ct state established flow add @bulk

        ct state established,related accept
        ct state invalid drop

        # Mirror of the input chain's non-SYN drop.
        tcp flags & (fin|syn|rst|ack) != syn counter name "forward_nonsyn" drop comment "forward non-syn drop"

        # Container egress to anything but another podman bridge: WAN,
        # home LAN, VLAN sub-interfaces and wireguard. Netavark masquerades
        # every bridge it manages under both of its firewall drivers, so
        # this table carries no NAT chain. Cross-bridge traffic must take
        # the DNAT rules below.
        iifname "podman*" oifname != "podman*" accept comment "podman → external (WAN/LAN/wireguard)"

        # Authelia publishes its forward-auth backend on every host address.
        # Nginx on the Authelia host connects over loopback, which never
        # crosses FORWARD; nginx on every other host crosses the wireguard
        # mesh. Admit only that path ahead of the broader DNAT accepts below,
        # which would otherwise open it to the LAN, the tailnet and every
        # container. Hosts without Authelia publish nothing on the port.
        ct status dnat oifname "podman*" meta l4proto tcp ct original proto-dst {{ service_ports.authelia }} \
            iifname "wg0" ip saddr $WG_SUBNET counter name "forward_authelia_wg" accept comment "Authelia forward-auth (wireguard peers)"
        ct status dnat oifname "podman*" meta l4proto tcp ct original proto-dst {{ service_ports.authelia }} \
            counter name "forward_authelia_drop" drop comment "Authelia forward-auth (outside the wireguard mesh)"
{% if tailscale_advertise_routes is defined %}

        # Tailscale subnet router and exit node: relay tailnet clients to the
        # advertised routes and the internet. tailscaled SNATs that traffic
        # itself, and ts-forward's accept cannot survive this chain's policy
        # drop. The headscale ACL gates the overlay, so oifname stays open,
        # which also lets tailnet clients reach published containers.
        iifname "tailscale0" counter name "tailscale_forward_accept" accept comment "tailscale subnet router + exit node"
{% endif %}

        # Reach containers through netavark's DNAT: PREROUTING rewrites
        # every published port, so those flows meet these rules and never
        # INPUT. Ingress is a trusted iface (LAN, wireguard, the DNS vmac)
        # or a podman bridge, for a container querying a VIP or host IP
        # that DNATs back into a bridge. Netavark's own chain accepts these
        # flows, but a drop in any base chain at the hook wins, so this
        # chain's policy drop would discard them without these accepts.
        #
        # Known gap on the second rule: any container reaches any
        # DNAT-marked tuple, including 0.0.0.0-published services on other
        # bridges. A compromised container could pivot to internal services;
        # tightening needs an oifname allowlist or a sensitive-dport
        # denylist (home-environment trade).
        iifname @lan_admin_ifaces oifname "podman*" \
            ct status dnat accept comment "Reach containers (LAN + wireguard ingress)"
        iifname "podman*" oifname "podman*" ct status dnat \
            accept comment "container → VIP → container (cross- or same-bridge DNAT)"

        # Deny direct container-IP lateral movement between bridges.
        # Same-bridge traffic is switched at L2 and never reaches FORWARD.
        ip saddr { $PODMAN_DEFAULT, $PODMAN_POOL } ip daddr { $PODMAN_DEFAULT, $PODMAN_POOL } \
            counter name "forward_podman_isolation" drop comment "podman direct cross-network isolation"

{% if dns_vrrp_enabled %}
        # Stale DNAT/ARP during a VIP handoff can route original-VIP traffic
        # through the old holder's vmac. Valid container DNAT was accepted
        # above; count and silence only the residual handoff traffic.
        iifname "vrrp.{{ dns_keepalived_vrid }}" ct original ip daddr {{ network.virtual_ips.dns }} counter name "forward_silenced_vip" drop comment "DNS VIP handoff leakage"
{% endif %}

        # Catch-all: log and drop.
        limit rate 5/minute burst 10 packets log prefix "[nftables] FORWARD:DROP: "
        counter name "forward_catchall" drop comment "forward catch-all"
    }
}
