# {{ ansible_managed }}
# Read-only viewer for getmail's flat Gmail archive; launch with mail-archive.
# Design: notes/archive/getmail_webmail_design.md.

set mbox_type = Maildir
# Use the read-only bind mount; getmail writes /mnt/services/getmail directly.
set folder    = /mnt/services/mutt/archive
set spoolfile = /mnt/services/mutt/archive
# Read-only viewer: no sent/draft folders to write to.
set record    = ""
set postponed = ""

# Cache parsed headers outside the read-only Maildir and $HOME.
# message_cachedir only serves IMAP/POP; Maildir bodies are already local.
set header_cache     = /mnt/services/mutt/headers

# Notmuch indexes the source Maildir with a separate database and flag sync off.
# The launcher exports NOTMUCH_CONFIG=/opt/mutt/notmuch-config for this backend.
set nm_default_url = notmuch:///mnt/services/mutt/notmuch
set nm_query_type  = messages
virtual-mailboxes "All Mail Search" "notmuch://?query=tag:archive"
bind index,pager X change-vfolder
bind index,pager \eX vfolder-from-query-readonly

# Reinforce the launcher's -R: no moving, aging, or trashing archived mail.
set read_only     = yes
set move          = no
set mark_old      = no
set maildir_trash = no
unset confirm_append

# Browsing ergonomics for one big flat archive.
set sort         = reverse-date-received
set date_format  = "%Y-%m-%d %H:%M"
# %D uses date_format in local time, avoiding strftime braces that collide with Jinja.
set index_format = "%4C %Z %D %-25.25F %s"
set pager_index_lines = 12
set pager_context     = 3
set pager_stop        = yes
set tilde
set mail_check_stats

# Unlabelled legacy mail needs these charset fallbacks instead of US-ASCII.
set assumed_charset = "utf-8:windows-1252:iso-8859-1"

# Render HTML inline through the managed w3m mailcap.
set mailcap_path = /opt/mutt/mailcap
auto_view text/html
alternative_order text/plain text/enriched text/html
