# {{ ansible_managed }}
# Protect the Maildir view even without neomutt's -R; getmail writes What= directly.
# The filename mnt-services-mutt-archive.mount must match the escaped Where= path.
[Unit]
Description=Read-only bind mount of the getmail archive for mutt
# Pull in and order after the source's backing mount (ZFS services on prod).
RequiresMountsFor=/mnt/services/getmail
AssertPathIsDirectory=/mnt/services/getmail/new

[Mount]
What=/mnt/services/getmail
Where=/mnt/services/mutt/archive
Type=none
DirectoryMode=0700
# libmount applies ro to the bind through a follow-up remount.
# Deny device nodes, setuid bits, and execution in attacker-authored mail;
# noatime avoids access-time writes through this view.
Options=bind,ro,nodev,nosuid,noexec,noatime

[Install]
WantedBy=multi-user.target
