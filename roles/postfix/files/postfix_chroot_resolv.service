# Every postfix start syncs /etc/resolv.conf into the queue directory for
# chrooted services, keeping the source's owner, then warns when that copy is
# not owned by root. Resolute's stub resolv.conf belongs to systemd-resolve.
# The sync skips a copy whose size and mtime already match the source, so
# seeding a root-owned one first leaves it in place.
#
# WantedBy and PartOf rerun the seed ahead of every postfix start and restart.
[Unit]
Description=Seed a root-owned resolv.conf copy for the Postfix chroot
ConditionPathExists=/etc/resolv.conf
Before=postfix.service
PartOf=postfix.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -D -p -m 0644 /etc/resolv.conf /var/spool/postfix/etc/resolv.conf

[Install]
WantedBy=postfix.service
