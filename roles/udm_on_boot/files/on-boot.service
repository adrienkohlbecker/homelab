# Implements the community unifios-utilities /data/on_boot.d/*.sh convention
# locally; installing its package would collide with this unit and directory.
# The scripts live on /data; this unit lives in /etc/systemd/system, so the
# framework relies on UniFi firmware updates keeping /etc (they wipe /usr).
[Unit]
Description=Run /data/on_boot.d scripts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
TimeoutStartSec=120
# Every script runs even when an earlier one fails, so one broken recovery
# (e.g. a keepalived reinstall) cannot strand the others; run-parts still
# exits non-zero, which leaves the unit failed. run-parts rejects dotted
# names by default, so --regex selects *.sh while still excluding Ansible
# backups; non-executables are skipped and an empty directory succeeds.
ExecStart=/bin/run-parts --regex '[.]sh$' --report /data/on_boot.d

[Install]
WantedBy=multi-user.target
