# Implements the community unifios-utilities /data/on_boot.d/*.sh convention
# locally; installing its package would collide with this unit and directory.
# The framework survives UniFi firmware updates because /data persists.
[Unit]
Description=Run /data/on_boot.d scripts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
TimeoutStartSec=120
# --exit-on-error surfaces failed recovery scripts in the unit status.
# run-parts rejects dotted names by default, so --regex selects *.sh while
# still excluding Ansible backups; non-executables are skipped and an empty
# directory succeeds.
ExecStart=/bin/run-parts --exit-on-error --regex '[.]sh$' --report /data/on_boot.d

[Install]
WantedBy=multi-user.target
