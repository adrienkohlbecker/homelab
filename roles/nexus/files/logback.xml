<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- disable logback initialization status messages, which go to stdout prior to the rest of this being loaded -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <jmxConfigurator/>

  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="org.sonatype.nexus.logging.NexusLogFilter" />
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
      <withSequenceNumber>false</withSequenceNumber>
      <withTimestamp>false</withTimestamp>
      <withNanoseconds>false</withNanoseconds>
      <withContext>false</withContext>
      <withFormattedMessage>true</withFormattedMessage>
      <withMessage>false</withMessage>
      <withArguments>false</withArguments>
    </encoder>
  </appender>

  <appender name="taskconsole" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="org.sonatype.nexus.logging.TaskLogsFilter" />
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
      <withSequenceNumber>false</withSequenceNumber>
      <withTimestamp>false</withTimestamp>
      <withNanoseconds>false</withNanoseconds>
      <withContext>false</withContext>
      <withFormattedMessage>true</withFormattedMessage>
      <withMessage>false</withMessage>
      <withArguments>false</withArguments>
    </encoder>
  </appender>

  <appender name="replicationconsole" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="org.sonatype.nexus.logging.ReplicationLogsFilter" />
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
      <withSequenceNumber>false</withSequenceNumber>
      <withTimestamp>false</withTimestamp>
      <withNanoseconds>false</withNanoseconds>
      <withContext>false</withContext>
      <withFormattedMessage>true</withFormattedMessage>
      <withMessage>false</withMessage>
      <withArguments>false</withArguments>
    </encoder>
  </appender>

  <!-- nginx is the authoritative inbound access log. Keep this logger isolated
       with no appender so direct health probes do not duplicate that stream. -->
  <logger name="org.eclipse.jetty.server.RequestLog" additivity="false" />

  <appender name="outboundRequestsConsole" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="org.sonatype.nexus.logging.OutboundRequestsLogFilter" />
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
      <withSequenceNumber>false</withSequenceNumber>
      <withTimestamp>false</withTimestamp>
      <withNanoseconds>false</withNanoseconds>
      <withContext>false</withContext>
      <withFormattedMessage>true</withFormattedMessage>
      <withMessage>false</withMessage>
      <withArguments>false</withArguments>
    </encoder>
  </appender>
  <logger name="outboundRequests" additivity="false">
    <appender-ref ref="outboundRequestsConsole"/>
  </logger>

  <!-- Audit messages are already JSON; emit them unchanged so downstream can
       select useful security and configuration events without nested JSON. -->
  <appender name="auditconsole" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
    <filter class="org.sonatype.nexus.logging.AuditLogFilter"/>
  </appender>

  <logger name="auditlog" additivity="false">
    <appender-ref ref="auditconsole"/>
  </logger>

  <appender name="reconciliationconsole" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
      <withSequenceNumber>false</withSequenceNumber>
      <withTimestamp>false</withTimestamp>
      <withNanoseconds>false</withNanoseconds>
      <withContext>false</withContext>
      <withFormattedMessage>true</withFormattedMessage>
      <withMessage>false</withMessage>
      <withArguments>false</withArguments>
    </encoder>
  </appender>
  <logger name="blobstore-reconciliation-log" additivity="false">
    <appender-ref ref="reconciliationconsole"/>
  </logger>

  <appender name="metrics" class="org.sonatype.nexus.logging.InstrumentedAppender"/>

  <logger name="ch.qos.logback" level="WARN"/>
  <logger name="org.eclipse.jetty.ee8.webapp" level="INFO"/>
  <logger name="org.eclipse.jetty.ee8.webapp.StandardDescriptorProcessor" level="WARN"/>

  <logger name="software.amazon.awssdk.services.ec2metadata" level="ERROR"/>
  <logger name="software.amazon.awssdk.auth.credentials" level="ERROR"/>
  <logger name="software.amazon.awssdk.regions" level="ERROR"/>

  <!-- G1 grows Eden close to the fixed heap before inexpensive young
       collections. Nexus reports this as high heap usage even with low old-gen
       occupancy and no full-GC pressure. Retain errors from the monitor. -->
  <logger name="org.sonatype.nexus.selfhosted.internal.jvm.MemoryMonitor" level="ERROR"/>

  <root level="${root.level:-INFO}">
    <appender-ref ref="console"/>
    <appender-ref ref="taskconsole"/>
    <appender-ref ref="replicationconsole"/>
    <appender-ref ref="metrics"/>
  </root>
</configuration>
