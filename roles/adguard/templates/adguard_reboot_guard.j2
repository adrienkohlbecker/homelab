#!/bin/bash
set -euo pipefail

# Hold a logind shutdown block lock while no DNS peer answers, so a reboot
# cannot take down the last DNS server. systemd 257+ (Resolute) logind
# enforces the lock against root. Noble's logind ignores a lock held by the
# caller's own uid, so root reboots pass there and only the site.yml DNS
# safety gate protects the Ansible reboot path. NUT's SHUTDOWNCMD bypasses
# logind on purpose (see roles/nut/templates/upsmon.conf.j2).

{# udm is excluded: its last-resort dnsmasq failover has no adguard.home
   record, so it can never satisfy check_peers -- it serves degraded DNS,
   not a healthy peer worth releasing the reboot lock for, and probing it
   would only add dead dig timeouts to every cycle. #}
PEER_IPS=(
{% for peer in dns_keepalived_peers | reject('eq', inventory_hostname) | reject('eq', 'udm') | sort %}
  {{ external_ips[peer] }}
{% endfor %}
)

LOCK_PID=

release_lock() {
  if [ -n "$LOCK_PID" ]; then
    # A vanished inhibitor is already released; reap it if it still exists.
    kill "$LOCK_PID" 2>/dev/null || true
    wait "$LOCK_PID" 2>/dev/null || true
    LOCK_PID=
    echo "lock released - peer is healthy" >&2
  fi
}

update_lock() {
  for ip in "${PEER_IPS[@]}"; do
    if dig +short +timeout=3 +tries=2 "@${ip}" adguard.home A | grep -Fxq 127.0.0.1; then
      release_lock
      return 0
    fi
  done
  if [ -z "$LOCK_PID" ]; then
    systemd-inhibit \
      --what=shutdown \
      --mode=block \
      --who="adguard_reboot_guard" \
      --why="No healthy DNS peer - this host is the last DNS server" \
      sleep infinity &
    LOCK_PID=$!
    echo "lock taken - no peer answered DNS" >&2
  fi
}

trap 'release_lock; exit 0' SIGTERM SIGINT

while true; do
  update_lock
  sleep 30
done
