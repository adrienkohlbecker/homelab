{% set adguard_podman_gateway = adguard_network_info.networks[0].subnets[0].gateway %}
http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  address: 0.0.0.0:3000
  session_ttl: 30d
{#
  The UI/API has no app user because its only LAN ingress is the
  Authelia-gated nginx vhost over the loopback publish. Published-port
  hairpins still let local containers reach the unauthenticated API;
  accepted here. Binding the container to 127.0.0.1 breaks that DNAT.
#}
users: []
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  anonymize_client_ip: false
{#
  The upstream 20 rps default is too tight for a busy household client;
  retain a per-client /32 budget.
#}
  ratelimit: 300
  ratelimit_subnet_len_ipv4: 32
  ratelimit_subnet_len_ipv6: 64
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
    - https://cloudflare-dns.com/dns-query
  upstream_dns_file: ""
  bootstrap_dns:
{% for resolver in bootstrap_dns_resolver %}
    - {{ resolver ~ ':53' }}
{% endfor %}
  fallback_dns:
    - https://dns.google/dns-query
  upstream_mode: load_balance
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts: []
{#
  The nginx loopback publish reaches the container from this network's
  gateway. Trust that address, not the bridge range, so containers cannot
  forge X-Forwarded-For.
#}
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
    - {{ adguard_podman_gateway }}/32
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
{#
  During an upstream outage, serve cached names for at most 12h with a
  short answer TTL while refreshing them in the background.
#}
  cache_optimistic: true
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
{# DDR cannot authenticate this RFC1918 resolver without an IP SAN;
   DHCP DNR advertises the DoT endpoint instead. #}
  handle_ddr: false
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams:
    - {{ external_ips.udm ~ ':53' }}
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
{# QUIC 0-RTT repeatedly failed on this path, so upstreams stay on HTTP/2. #}
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: false
  pending_requests:
    enabled: true
tls:
  enabled: true
  server_name: dns.{{ domain }}
  force_https: false
{# nginx owns HTTPS; only DoT 853/tcp is published on the VIP. #}
  port_https: 0
  port_dns_over_tls: 853
  port_dns_over_quic: 0
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: /opt/adguardhome/conf/tls/fullchain.pem
  private_key_path: /opt/adguardhome/conf/tls/privkey.pem
  strict_sni_check: false
{# Query history must not ride service-state snapshots and replication. #}
querylog:
  dir_path: ""
  ignored: []
  interval: 30d
  size_memory: 1000
  enabled: false
  ignored_enabled: false
  file_enabled: false
statistics:
  dir_path: ""
{# Exclude the once-per-second keepalived probe from statistics. #}
  ignored:
    - adguard.home
  interval: 10d
  enabled: true
  ignored_enabled: true
filters:
{% for url in adguard_adlists %}
  - enabled: true
    url: {{ url }}
    name: blocklist_{{ loop.index }}
    id: {{ loop.index }}
{% endfor %}
whitelist_filters: []
{# These ! entries are Adblock data preserved by AdGuard's rewrite. Match
   yaml.v3 serialization: the regex stays plain, while ! and | entries are
   quoted, or every converge re-templates and restarts DNS. #}
user_rules:
  - '! Keep internal typos local: NXDOMAIN for single-label names and'
  - '! undelegated LAN suffixes instead of leaking them upstream.'
  - '! The regex excludes colons so HTTPS-record ipv6hints survive filtering.'
  - /^[^.:]+$/$dnsrewrite=NXDOMAIN
  - '||lan^$dnsrewrite=NXDOMAIN'
  - '||local^$dnsrewrite=NXDOMAIN'
  - '||internal^$dnsrewrite=NXDOMAIN'
  - '||test^$dnsrewrite=NXDOMAIN'
  - '||home.arpa^$dnsrewrite=NXDOMAIN'
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: {{ system_timezone }}
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites:
    - domain: adguard.home
      answer: 127.0.0.1
      enabled: true
{% for host in ['pug', 'lab'] %}
    - domain: {{ host }}.{{ domain }}
      answer: {{ external_ips[host] }}
      enabled: true
    - domain: '*.{{ host }}.{{ domain }}'
      answer: {{ external_ips[host] }}
      enabled: true
{% endfor %}
{# fox stays on its public tailnet record because it is off-home. #}
    - domain: auth.{{ domain }}
      answer: {{ external_ips.lab }}
      enabled: true
    - domain: dns.{{ domain }}
      answer: {{ network.virtual_ips.dns }}
      enabled: true
  safe_fs_patterns: []
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
{# Clients are private, so use UDM-backed rDNS without public WHOIS. #}
    whois: false
    arp: true
    rdns: true
    dhcp: true
    hosts: true
{#
  Match AdGuard's clientObject field order and name sorting. Pin UIDs so
  its startup rewrite cannot generate UUIDs and cause restart drift.
#}
  persistent:
{#
  netavark hairpin NAT collapses host and container queries onto the bridge
  gateway, so represent that shared source as one client.
#}
    - safe_search:
        enabled: false
        bing: true
        duckduckgo: true
        ecosia: true
        google: true
        pixabay: true
        yandex: true
        youtube: true
      blocked_services:
        schedule:
          time_zone: {{ system_timezone }}
        ids: []
      name: {{ inventory_hostname }} (host + containers)
      ids:
        - {{ adguard_podman_gateway }}
      tags: []
      upstreams: []
      uid: 01970612-0000-7000-8000-000000000001
      upstreams_cache_size: 0
      upstreams_cache_enabled: false
      use_global_settings: true
      filtering_enabled: false
      parental_enabled: false
      safebrowsing_enabled: false
      use_global_blocked_services: true
      ignore_querylog: false
      ignore_statistics: false
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: 34
