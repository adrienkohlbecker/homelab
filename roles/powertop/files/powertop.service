# Shadows the packaged unit to bound startup and keep successful completion
# active. Auto-tune includes USB HID autosuspend, so use only on headless hosts.
[Unit]
Description=PowerTOP auto tune
Documentation=man:powertop(8)

[Service]
Type=oneshot
TimeoutStartSec=60
RemainAfterExit=true
ExecStart=/usr/sbin/powertop --auto-tune
# Auto-tune turns the NMI hard-lockup watchdog off, which leaves the panic
# role's hardlockup_panic inert. Re-arm it wherever a CPU perf PMU backs the
# detector; VMs can expose the sysctl without one, and the write then fails.
ExecStartPost=/bin/sh -c 'if ls /sys/bus/event_source/devices/cpu* >/dev/null 2>&1; then exec /sbin/sysctl -qw kernel.nmi_watchdog=1; fi'

[Install]
WantedBy=multi-user.target
