{# Per-block interface unit; inputs and defaults are documented in tasks/main.yml. #}
{% set _host_ip = macvlan_args.host_ip | default(macvlan_block | ansible.utils.ipmath(0)) %}
{% set _mac = macvlan_args.mac_address | default('82:48:10' | random_mac(seed=(inventory_hostname ~ '_' ~ macvlan_args.name))) %}
[Unit]
Description={{ macvlan_args.name }} interface setup
# Wait for the parent device; network.target does not guarantee it exists.
# BindsTo tracks device removal, not carrier changes.
After=sys-subsystem-net-devices-{{ macvlan_args.parent }}.device
BindsTo=sys-subsystem-net-devices-{{ macvlan_args.parent }}.device
ConditionPathExists=/sys/class/net/{{ macvlan_args.parent }}
# Child removal makes the unit inactive so reconverge recreates it.
# No After= here: this unit creates the child, so ordering after it deadlocks.
BindsTo=sys-subsystem-net-devices-{{ macvlan_args.name }}.device

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogIdentifier=%N

# A partial start can leave the iface behind without running ExecStop.
# Ignore a missing iface during cleanup.
ExecStartPre=-/bin/ip link delete {{ macvlan_args.name }}
ExecStart=/bin/ip link add {{ macvlan_args.name }} link {{ macvlan_args.parent }} address {{ _mac }} type macvlan mode bridge
ExecStart=/bin/ip addr add {{ _host_ip }}/32 dev {{ macvlan_args.name }}
# Match the parent ARP settings after creation, when the child sysctls exist.
ExecStart=/sbin/sysctl -q -w net.ipv4.conf.{{ macvlan_args.name }}.arp_ignore=1
ExecStart=/sbin/sysctl -q -w net.ipv4.conf.{{ macvlan_args.name }}.arp_announce=2
ExecStart=/bin/ip link set {{ macvlan_args.name }} up
# Use the child IP as the source for host-originated traffic into this block.
ExecStart=/bin/ip route add {{ macvlan_block }} dev {{ macvlan_args.name }} proto static src {{ _host_ip }}
ExecStop=-/bin/ip link delete {{ macvlan_args.name }}

[Install]
WantedBy=multi-user.target
