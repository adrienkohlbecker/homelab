#jinja2: lstrip_blocks: True
{% macro aws_instance_runner(name_suffix, token, asg_name, capacity, max_instances, idle_time) %}
[[runners]]
  name = "{{ inventory_hostname }}-{{ name_suffix }}"
  url = "https://gitlab.com"
  token = "{{ token }}"
  executor = "instance"
  shell = "bash"
  limit = {{ max_instances * capacity }}
  request_concurrency = 4
  # The AMI mounts local NVMe at /mnt/scratch and pre-creates these paths.
  builds_dir = "/mnt/scratch/gitlab-runner/builds"
  cache_dir = "/mnt/scratch/gitlab-runner/cache"

  [runners.autoscaler]
    plugin = "fleeting-plugin-aws"
    capacity_per_instance = {{ capacity }}
    max_use_count = 0
    max_instances = {{ max_instances }}
    delete_instances_on_shutdown = true
    instance_ready_command = "/usr/local/bin/homelab_ci_ready"

    [runners.autoscaler.plugin_config]
      name = "{{ asg_name }}"
      profile = "{{ gitlab_runner_aws_qemu_profile }}"
      config_file = "/mnt/services/gitlab_runner/.aws/config"
      credentials_file = "/mnt/services/gitlab_runner/.aws/credentials"
      scale_in_termination = true

    [runners.autoscaler.connector_config]
      username = "{{ gitlab_runner_aws_qemu_username }}"
      use_external_addr = true
      timeout = "15m0s"

    [[runners.autoscaler.policy]]
      idle_count = 0
      idle_time = "{{ idle_time }}"
      preemptive_mode = false
{% endmacro %}
# Managed by ansible (roles/gitlab_runner) -- do not edit on the host.
#
# Tags, locking, and protected-runner policy live in GitLab's registration.
concurrent = {{ gitlab_runner_concurrent }}
# Avoid the default ANSI-decorated log format.
log_format = "json"
# Allow long cells to drain; the unit timeout is the later kill backstop.
shutdown_timeout = 1800
# Metrics and inseparable pprof endpoints are intentionally loopback-only.
listen_address = "127.0.0.1:{{ service_ports.gitlab_runner }}"

{% if gitlab_runner_shell_enabled %}
[[runners]]
  name = "{{ inventory_hostname }}-shell-qemu"
  url = "https://gitlab.com"
  # Vaulted project-runner token.
  token = "{{ gitlab_runner_shell_token }}"
  executor = "shell"
  shell = "bash"
  # Keep enough requests outstanding to avoid long-poll stalls.
  request_concurrency = 4
{% endif %}
{% if gitlab_runner_aws_qemu_enabled %}

# AWS qemu runner: an instance executor backed by fleeting-plugin-aws and a
# dedicated Auto Scaling Group. Jobs run directly on hosts with nested KVM.
{{ aws_instance_runner(
     'aws-shell-qemu',
     gitlab_runner_aws_qemu_token,
     gitlab_runner_aws_qemu_asg_name,
     gitlab_runner_aws_qemu_capacity_per_instance,
     gitlab_runner_aws_qemu_max_instances,
     gitlab_runner_aws_qemu_idle_time
   ) }}

# Dedicated one-host, one-job pool for the full-site converge cell.
{{ aws_instance_runner(
     'aws-shell-qemu-site',
     gitlab_runner_aws_qemu_site_token,
     gitlab_runner_aws_qemu_site_asg_name,
     1,
     1,
     gitlab_runner_aws_qemu_site_idle_time
   ) }}
{% endif %}
