#jinja2: lstrip_blocks: True
{% macro aws_instance_runner(name_suffix, token, asg_name, capacity, max_instances, request_concurrency, idle_time) %}
[[runners]]
  name = "{{ inventory_hostname }}-{{ name_suffix }}"
  url = "https://gitlab.com"
  token = "{{ token }}"
  executor = "instance"
  shell = "bash"
  limit = {{ max_instances * capacity }}
  request_concurrency = {{ request_concurrency }}
  # The AMI mounts local NVMe at /mnt/scratch and pre-creates these paths.
  builds_dir = "/mnt/scratch/gitlab-runner/builds"
  cache_dir = "/mnt/scratch/gitlab-runner/cache"

  [runners.autoscaler]
    plugin = "fleeting-plugin-aws"
    capacity_per_instance = {{ capacity }}
    max_use_count = 0
    max_instances = {{ max_instances }}
    delete_instances_on_shutdown = true
    instance_ready_command = "/usr/local/bin/homelab_ci_ready"

    [runners.autoscaler.plugin_config]
      name = "{{ asg_name }}"
      profile = "{{ gitlab_runner_aws_qemu_profile }}"
      config_file = "/mnt/services/gitlab_runner/.aws/config"
      credentials_file = "/mnt/services/gitlab_runner/.aws/credentials"
      scale_in_termination = true

    [runners.autoscaler.connector_config]
      username = "{{ gitlab_runner_aws_qemu_username }}"
      use_external_addr = true
      timeout = "15m0s"

    [[runners.autoscaler.policy]]
      idle_count = 0
      idle_time = "{{ idle_time }}"
      preemptive_mode = false
{% endmacro %}
# Managed by ansible (roles/gitlab_runner) -- do not edit on the host.
#
# GitLab Runner config. fox uses the Docker executor against gitlab_runner's
# rootless podman socket for AWS orchestration jobs; lab can use the shell
# executor to run qemu cells directly. Tags / locked / run-untagged / protected
# all live server-side with the glrt- runner registration, not in this file.
concurrent = {{ gitlab_runner_concurrent }}
# JSON logs parse cleanly in fluentbit (the repo's only log consumer); the
# default `runner` format is ANSI-decorated and needs a custom parser.
log_format = "json"
# Graceful-shutdown drain: on SIGQUIT (systemctl stop/restart) the runner stops
# claiming jobs and waits up to this many seconds for in-flight jobs to finish
# before force-exiting. The default is 30s -- far too short to wind a cell
# matrix down -- so hold it ~30 min, enough to cover the longest jobs (AMI
# bakes). The unit's TimeoutStopSec sits just past this bound (1860s) so
# systemd only SIGKILLs a runner too wedged to run the drain at all.
shutdown_timeout = 1800
# Prometheus metrics + pprof, loopback-only (fox's netdata go.d prometheus
# collector scrapes it). Unauthenticated, and the pprof debug endpoints cannot
# be disabled separately from metrics -- accepted on loopback (any local
# process can trigger profiling), but re-evaluate if this listener ever moves
# off 127.0.0.1.
listen_address = "127.0.0.1:{{ service_ports.gitlab_runner }}"

[[runners]]
  name = "{{ inventory_hostname }}-{{ 'shell-qemu' if gitlab_runner_executor == 'shell' else 'docker-aws' }}"
  url = "https://gitlab.com"
  # glrt- authentication token from creating the runner in the GitLab project
  # (Settings -> CI/CD -> Runners -> New project runner). Vaulted in host_vars.
  token = "{{ gitlab_runner_token }}"
  executor = "{{ gitlab_runner_executor }}"
{% if gitlab_runner_executor == 'shell' %}
  shell = "bash"
{% endif %}
  # Bounds this runner independently of the process-wide `concurrent`.
  limit = {{ gitlab_runner_limit }}
  # Concurrent new-job requests to GitLab. The default 1 keeps a single request
  # in flight, so when it blocks on a long poll the runner trips its long-polling
  # bottleneck warning (loud once a second runner also polls). 4 is upstream's
  # 2-4 recommendation -- enough outstanding requests to clear the stall without
  # hammering GitLab's API.
  request_concurrency = 4

{% if gitlab_runner_executor == 'docker' %}
  [runners.docker]
    # gitlab_runner's rootless podman socket (socket-activated; linger keeps
    # the user manager alive). Rootless keeps the runner non-root-equivalent
    # on this host.
    host = "unix:///run/user/{{ gitlab_runner_user.uid }}/podman/podman.sock"
    # Default job image: the project CI image (mise tool tree + warm uv
    # cache baked in -- see .gitlab-ci.yml's ci_image job). Jobs may still
    # name another image; the runner is locked to this project so there is
    # no allowed_images policy to maintain.
    image = "registry.gitlab.com/akohlbecker/homelab/ci:latest"
    # Job containers orchestrate remote EC2 cells over ssh/https only -- no
    # devices, no nested containers, no privileges.
    privileged = false
{% endif %}
{% if gitlab_runner_aws_qemu_enabled | default(false) %}

# AWS qemu runner: an instance executor backed by fleeting-plugin-aws and a
# dedicated Auto Scaling Group. Jobs run directly on hosts with nested KVM.
{{ aws_instance_runner(
     'aws-shell-qemu',
     gitlab_runner_aws_qemu_token,
     gitlab_runner_aws_qemu_asg_name,
     gitlab_runner_aws_qemu_capacity_per_instance,
     gitlab_runner_aws_qemu_max_instances,
     4,
     gitlab_runner_aws_qemu_idle_time
   ) }}
{% endif %}
{% if gitlab_runner_aws_qemu_site_enabled | default(false) %}

# Dedicated one-host, one-job pool for the full-site converge cell.
{{ aws_instance_runner(
     'aws-shell-qemu-site',
     gitlab_runner_aws_qemu_site_token,
     gitlab_runner_aws_qemu_site_asg_name,
     1,
     1,
     1,
     gitlab_runner_aws_qemu_site_idle_time
   ) }}
{% endif %}
