#jinja2: lstrip_blocks: True
# Host-native GitLab Runner; Docker jobs use rootless podman.
[Unit]
Description=GitLab Runner ({{ gitlab_runner_executor }} executor)
After=network-online.target
Wants=network-online.target
# Keep slow network recovery inside the restart burst window.
StartLimitIntervalSec=600
StartLimitBurst=5
{% if zfs_root %}
{% if zfs_has_services_mount %}
# The working directory lives on the services dataset.
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
{% endif %}
# Do not join zfs_autosnapshot.target: job state is disposable and snapshots
# must not interrupt CI.

[Service]
Type=simple
User=gitlab_runner
Group=gitlab_runner
WorkingDirectory=/mnt/services/gitlab_runner
# The nologin user needs a writable HOME.
Environment=HOME=/mnt/services/gitlab_runner
ExecStart=/usr/local/bin/gitlab-runner run \
    --config /mnt/services/gitlab_runner/config.toml \
    --working-directory /mnt/services/gitlab_runner
Restart=always
RestartSec=10
# SIGQUIT drains to shutdown_timeout; systemd kills only after that bound.
KillSignal=SIGQUIT
TimeoutStopSec=1860

[Install]
WantedBy=multi-user.target
