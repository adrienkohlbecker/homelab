#jinja2: lstrip_blocks: True
# Host-native GitLab Runner.
[Unit]
Description=GitLab Runner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
{% if zfs_root and zfs_has_services_mount %}
# The working directory lives on the services dataset.
After=zfs_mount_mnt_services.service
Requires=zfs_mount_mnt_services.service
{% endif %}
# Do not join zfs_autosnapshot.target: job state is disposable and snapshots
# must not interrupt CI.

[Service]
# Successful coordinator progress adds no state. Keep retries, incomplete
# accepts, final outcomes, and taskscaler decisions.
LogFilterPatterns=~\x22msg\x22:\x22(Appending trace to coordinator[.][.][.]ok|Updating job[.][.][.]|Submitting job to coordinator[.][.][.]ok)\x22
User=gitlab_runner
Group=gitlab_runner
WorkingDirectory=/mnt/services/gitlab_runner
# The nologin user needs a writable HOME.
Environment=HOME=/mnt/services/gitlab_runner
ExecStart=/usr/local/bin/gitlab-runner run \
    --config /mnt/services/gitlab_runner/config.toml \
    --working-directory /mnt/services/gitlab_runner
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=10min
# SIGQUIT drains to shutdown_timeout; systemd kills only after that bound.
KillSignal=SIGQUIT
TimeoutStopSec=1860

[Install]
WantedBy=multi-user.target
