# Generated by mise-tasks/ci/detect.py from mise-tasks/ci/test_child.yml.j2 -- do not edit.
# See notes/ci_aws_nested_qemu_cells.md.
default:
  interruptible: true

# GitLab renders stages as columns and truncates large single-stage job lists in
# the pipeline UI. Split cells across two columns; needs:[] keeps one DAG.
stages:
{% for stage in stages %}
  - {{ stage }}
{% endfor %}

.x86_cell:
  stage: test1
  needs: []
  # Qemu cells use protected shell runners; AWS hydrates S3 images while lab
  # boots its co-located bake artifacts.
  tags:
    - {{ cell_runner_tag }}
{% if image_oidc %}
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: sts.amazonaws.com
{% endif %}
  # Leave headroom around the harness's 25-minute deadline.
  timeout: 30m
  variables:
    # Select mirrors and DNS for the guest's network environment.
    HOMELAB_TEST_IN_AWS: "{{ "true" if in_aws else "false" }}"
    # Production vault material is deliberately unavailable in CI.
    ANSIBLE_VAULT_IDENTITY_LIST: test@vault-client.sh
{% if baked_toolchain %}
    # Reuse the AMI's tool/cache trees, but copy into a per-job venv so
    # concurrent cells never share one.
    MISE_DATA_DIR: /opt/mise
    UV_CACHE_DIR: /opt/uv-cache
    UV_LINK_MODE: copy
{% endif %}
  before_script:
    - test -n "${HOMELAB_VAULT_PASSWORD_TEST:-}" || { echo "HOMELAB_VAULT_PASSWORD_TEST CI/CD variable is not set" >&2; exit 1; }
    - mise run ci:bootstrap
{% if image_oidc %}
    # The branch-safe cell role can only read promoted qemu bundles.
    - source mise-tasks/ci/aws-oidc.sh {{ cell_role_arn }} "{{ target }}-x86-cell-$CI_JOB_ID" --cache-dir
    # minimal downloads its cloud image directly and has no bundle to hydrate.
    - if [ "$VARIANT" != "minimal" ]; then mise run ci:hydrate-qemu-images "$VARIANT" --ubuntu "$UBUNTU"; fi
{% endif %}
  artifacts:
    when: on_failure
    expire_in: 30 days
    paths:
      - test/out/
{% if target == "aws_qemu" %}

# ARM jobs use a separate native pool and architecture-specific guest images.
# They keep their own scaffold so x86 and hosted aggregation cannot inherit
# ARM runner state accidentally.
.arm_cell:
  stage: arm
  needs: []
  tags:
    - {{ arm_runner_tag }}
  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: sts.amazonaws.com
  timeout: 45m
  variables:
    ARCH: aarch64
    HOMELAB_TEST_IN_AWS: "true"
    ANSIBLE_VAULT_IDENTITY_LIST: test@vault-client.sh
    MISE_DATA_DIR: /opt/mise
    UV_CACHE_DIR: /opt/uv-cache
    UV_LINK_MODE: copy
  before_script:
    - test -n "${HOMELAB_VAULT_PASSWORD_TEST:-}" || { echo "HOMELAB_VAULT_PASSWORD_TEST CI/CD variable is not set" >&2; exit 1; }
    - mise run ci:bootstrap
    - source mise-tasks/ci/aws-oidc.sh {{ cell_role_arn }} "aws_qemu-arm-cell-$CI_JOB_ID" --cache-dir
    # Minimal boots its upstream cloud image without a promoted bundle.
    - if [ "$VARIANT" != "minimal" ]; then mise run ci:hydrate-qemu-images "$VARIANT" --ubuntu "$UBUNTU" --architecture aarch64; fi
  after_script:
    - rm -f "$CI_PROJECT_DIR/.aws_web_identity_token"
  artifacts:
    when: always
    expire_in: 30 days
    paths:
      - test/out/
{% endif %}
{% if site_test %}

# The leading stage gives the critical-path converge the first build id;
# inherited needs:[] keeps it parallel with every cell. One converge per
# release, named like a cell spec, default release first.
{% for ubuntu in [default_ubuntu] + other_ubuntus %}
"_site_test:lab{{ '' if ubuntu == default_ubuntu else ':' ~ ubuntu }}":
  extends: .x86_cell
  stage: site
  variables:
    VARIANT: lab
    UBUNTU: {{ ubuntu }}
  timeout: 60m
  script:
    # timeout backstops the harness's own deadline; 60s permits VM teardown.
    - |
      rc=0
      mise exec -- timeout --kill-after=30s 3060 test/site_test.py --ubuntu "$UBUNTU" --timeout 3000 || rc=$?
      echo "harness exit code: $rc"
      exit $rc

{% endfor %}
# Full-site check mode covers cross-role rendering and gates.
"_site_check:lab":
  extends: .x86_cell
  stage: site
  variables:
    VARIANT: lab
    UBUNTU: {{ default_ubuntu }}
  timeout: 35m
  script:
    # Backstop the harness deadline with 60s for teardown.
    - |
      rc=0
      mise exec -- timeout --kill-after=30s 1860 test/site_test.py --check --timeout 1800 || rc=$?
      echo "harness exit code: $rc"
      exit $rc
{% endif %}
{% if keep_pools_test %}

# A live-ISO rebuild with KEEP_POOLS=1: a Lab fixture of another release
# rebuilt as the default release from a Minimal stand-in, then switched to and
# rolled back.
"_keep_pools_test:lab":
  extends: .x86_cell
  stage: rebuild
  variables:
    VARIANT: lab
    UBUNTU: {{ other_ubuntus | first }}
  timeout: 45m
  script:
    # timeout backstops the harness's own deadline; 60s permits VM teardown.
    - |
      rc=0
      mise exec -- timeout --kill-after=30s 2460 test/keep_pools_test.py --from "$UBUNTU" --to {{ default_ubuntu }} --timeout 2400 || rc=$?
      echo "harness exit code: $rc"
      exit $rc
{% endif %}
{% for group in cell_groups %}
{% for cell in group.cells %}

"{{ cell.spec }}":
  extends: .x86_cell
  stage: {{ group.stage }}
  variables:
    ROLE: {{ cell.role }}
    VARIANT: {{ cell.machine }}
    UBUNTU: {{ cell.ubuntu }}
  script:
    # timeout survives a wedged event loop; 60s permits VM teardown.
    # Cells share hosts with the critical-path site converge: lower CPU
    # priority lets it keep its vCPUs through the burst, and a higher OOM
    # score makes the kernel pick a cell over it under memory pressure.
    - |
      rc=0
      nice -n 10 choom -n 500 -- mise exec -- timeout --kill-after=30s 1560 test/testrole.py "$ROLE" --machine "$VARIANT" --ubuntu "$UBUNTU" --timeout 1500 --verbose || rc=$?
      echo "harness exit code: $rc"
      exit $rc
{% endfor %}
{% endfor %}
{% for cell in arm_cells %}

"{{ cell.spec }}:arm":
  extends: .arm_cell
  variables:
    ROLE: {{ cell.role }}
    VARIANT: {{ cell.machine }}
    UBUNTU: {{ cell.ubuntu }}
  script:
    - |
      rc=0
      mise exec -- timeout --kill-after=30s 1560 test/testrole.py "$ROLE" --machine "$VARIANT" --ubuntu "$UBUNTU" --timeout 1500 --verbose || rc=$?
      echo "harness exit code: $rc"
      exit $rc
{% endfor %}
{% if not cells and not arm_cells and not site_test and not keep_pools_test %}

no_cells:
  stage: test1
  image: alpine:3.22
  tags:
    - saas-linux-small-amd64
  script:
    - echo "no role-relevant changes; nothing to test"
{% endif %}
